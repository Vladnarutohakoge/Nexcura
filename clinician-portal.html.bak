      </section><!-- /referrals -->

      <!-- ══════════════════════════════════════════════════
           SECTION 6 — FOLLOW-UP TASKS
      ═══════════════════════════════════════════════════ -->
      <section class="section-view" id="section-tasks" aria-labelledby="tasks-heading">

        <div class="section-head">
          <span class="section-kicker">Task Management</span>
          <h2 id="tasks-heading">Follow-Up Tasks <em class="sample-tag">Illustrative sample only</em></h2>
          <p>Manage clinical follow-up actions. Check off tasks to mark as reviewed. Preview mode — no data is saved.</p>
        </div>

        <div class="notice notice-warn" role="note">
          <strong>⚠ Preview Mode</strong>
          Checking items off is a UI preview only. No task data is stored or transmitted.
        </div>

        <div class="card" style="margin-bottom:18px;">
          <div class="card-head">
            <h3>Active Tasks — Dr. A. Mehta</h3>
            <div style="display:flex;gap:8px;">
              <span class="badge badge-red">1 Overdue</span>
              <span class="badge badge-amber">2 Due Today</span>
              <span class="badge badge-slate">2 Upcoming</span>
            </div>
          </div>
          <div class="card-body">
            <ul class="task-list" role="list" aria-label="Follow-up tasks">

              <!-- Task 1 — HIGH / OVERDUE -->
              <li class="task-item" id="task-1" role="listitem">
                <div class="task-check-wrap">
                  <input type="checkbox" class="task-check" id="check-1"
                         aria-label="Mark task 1 complete: Review HbA1c lab results for R.D."
                         onchange="toggleTask('task-1', this)"/>
                </div>
                <label class="task-info" for="check-1" style="cursor:pointer;">
                  <span class="task-title">Review HbA1c lab results — R.D.</span>
                  <span class="task-desc">Lab panel returned 23 Sep 2026. HbA1c 8.1% — above target. Review and update care plan before today's appointment.</span>
                  <div class="task-meta">
                    <span class="badge badge priority-high">🔴 High Priority</span>
                    <span class="task-due overdue" aria-label="Overdue">⚠ Due: 23 Sep 2026 — Overdue</span>
                    <span class="task-patient">Patient: R.D.</span>
                  </div>
                </label>
              </li>

              <!-- Task 2 — HIGH / TODAY -->
              <li class="task-item" id="task-2" role="listitem">
                <div class="task-check-wrap">
                  <input type="checkbox" class="task-check" id="check-2"
                         aria-label="Mark task 2 complete: Review P.K. intake form before 10 AM appointment"
                         onchange="toggleTask('task-2', this)"/>
                </div>
                <label class="task-info" for="check-2" style="cursor:pointer;">
                  <span class="task-title">Review intake form — P.K. (New Patient)</span>
                  <span class="task-desc">P.K. submitted a pre-visit intake form at 09:42 AM. Review before 10:00 AM appointment. Flagged: BP history, family history of stroke.</span>
                  <div class="task-meta">
                    <span class="badge badge priority-high">🔴 High Priority</span>
                    <span class="task-due overdue">⚠ Due: Today 09:45 AM</span>
                    <span class="task-patient">Patient: P.K.</span>
                  </div>
                </label>
              </li>

              <!-- Task 3 — MED / TODAY -->
              <li class="task-item" id="task-3" role="listitem">
                <div class="task-check-wrap">
                  <input type="checkbox" class="task-check" id="check-3"
                         aria-label="Mark task 3 complete: Send referral confirmation to Cardiology for Patient B"
                         onchange="toggleTask('task-3', this)"/>
                </div>
                <label class="task-info" for="check-3" style="cursor:pointer;">
                  <span class="task-title">Send referral confirmation — Patient B → Cardiology</span>
                  <span class="task-desc">Referral REF-2654 is awaiting a covering letter. Attach clinical summary and BP readings before sending to Cardiology Department.</span>
                  <div class="task-meta">
                    <span class="badge badge priority-med">🟡 Medium Priority</span>
                    <span class="task-due">Due: Today EOD</span>
                    <span class="task-patient">Patient: Patient B</span>
                  </div>
                </label>
              </li>

              <!-- Task 4 — MED / UPCOMING -->
              <li class="task-item" id="task-4" role="listitem">
                <div class="task-check-wrap">
                  <input type="checkbox" class="task-check" id="check-4"
                         aria-label="Mark task 4 complete: Update care plan for M.L. following medication review"
                         onchange="toggleTask('task-4', this)"/>
                </div>
                <label class="task-info" for="check-4" style="cursor:pointer;">
                  <span class="task-title">Update care plan — M.L. post-medication review</span>
                  <span class="task-desc">Following today's medication review at 14:00, update Warfarin dosing plan and schedule INR monitoring in 10 days.</span>
                  <div class="task-meta">
                    <span class="badge badge priority-med">🟡 Medium Priority</span>
                    <span class="task-due">Due: 25 Sep 2026</span>
                    <span class="task-patient">Patient: M.L.</span>
                  </div>
                </label>
              </li>

              <!-- Task 5 — LOW / UPCOMING -->
              <li class="task-item" id="task-5" role="listitem">
                <div class="task-check-wrap">
                  <input type="checkbox" class="task-check" id="check-5"
                         aria-label="Mark task 5 complete: Complete clinical trial flag for R.D. — NCT04832167"
                         onchange="toggleTask('task-5', this)"/>
                </div>
                <label class="task-info" for="check-5" style="cursor:pointer;">
                  <span class="task-title">Clinical trial flag — R.D. / NCT04832167</span>
                  <span class="task-desc">Preliminary eligibility flagged for GLUCO-PRIME II trial. Complete eligibility worksheet and submit to study coordinator for review.</span>
                  <div class="task-meta">
                    <span class="badge badge priority-low">🟢 Low Priority</span>
                    <span class="task-due">Due: 30 Sep 2026</span>
                    <span class="task-patient">Patient: R.D.</span>
                  </div>
                </label>
              </li>

            </ul>

            <div class="inline-toast" id="task-toast" role="status" aria-live="polite">
              ℹ Preview only — task status is not saved. This is a demonstration interface only.
            </div>
          </div>
        </div>

      </section><!-- /tasks -->

    </main><!-- /pageContent -->
  </div><!-- /main-area -->
</div><!-- /app-shell -->

<div id="refModal" style="display:none; position:fixed; inset:0; background:rgba(15,34,54,0.4); z-index:9000; align-items:center; justify-content:center; backdrop-filter:blur(2px);">
  <div style="background:white; border-radius:var(--radius); width:450px; padding:20px; box-shadow:var(--shadow-lg);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
      <h3 style="color:var(--navy); font-family:Manrope,sans-serif;">Referral Details</h3>
      <button class="btn btn-ghost btn-sm" onclick="document.getElementById('refModal').style.display='none'">✕</button>
    </div>
    <div id="refModalContent" style="display:flex; flex-direction:column; gap:10px; font-size:12px;"></div>
  </div>
</div>
<script>
function openRefModal(btn) {
  const tr = btn.closest('tr');
  const tds = tr.querySelectorAll('td');
  const refNum = tds[0].textContent;
  const patient = tds[1].textContent;
  const dr = tds[2].textContent;
  const spec = tds[3].textContent;
  const reason = tds[4].textContent;
  const date = tds[5].textContent;
  const status = tds[6].textContent;
  
  document.getElementById('refModalContent').innerHTML = `
    <div><strong>Referral ID:</strong> ${refNum}</div>
    <div><strong>Patient:</strong> ${patient}</div>
    <div><strong>Referring Doctor:</strong> ${dr}</div>
    <div><strong>Specialty:</strong> ${spec}</div>
    <div><strong>Reason:</strong> ${reason}</div>
    <div><strong>Date:</strong> ${date}</div>
    <div><strong>Status:</strong> ${status}</div>
    <div style="margin-top:10px;"><strong>Clinical Notes:</strong><br>Patient referred for specialist review regarding aforementioned concerns. Please evaluate and advise on further management.</div>
  `;
  document.getElementById('refModal').style.display = 'flex';
}
</script>

<div id="labModal" style="display:none; position:fixed; inset:0; background:rgba(15,34,54,0.4); z-index:9000; align-items:center; justify-content:center; backdrop-filter:blur(2px);">
  <div style="background:white; border-radius:var(--radius); width:500px; padding:20px; box-shadow:var(--shadow-lg);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
      <h3 style="color:var(--navy); font-family:Manrope,sans-serif;">Recent Lab Results</h3>
      <button class="btn btn-ghost btn-sm" onclick="document.getElementById('labModal').style.display='none'">✕</button>
    </div>
    <div style="display:flex; flex-direction:column; gap:10px; max-height:400px; overflow-y:auto;">
      <div class="result-row" style="border:1px solid var(--line); padding:10px; border-radius:4px;">
        <div>
          <div class="result-name">HbA1c - R.D.</div>
          <div class="result-ref">Target <7.0% · 23 Sep 2026</div>
        </div>
        <div style="text-align:right">
          <div class="result-val">8.1%</div>
          <div class="result-flag">⚑ Flagged for review</div>
        </div>
      </div>
      <div class="result-row" style="border:1px solid var(--line); padding:10px; border-radius:4px;">
        <div>
          <div class="result-name">Fasting Glucose - R.D.</div>
          <div class="result-ref">3.9-5.6 mmol/L · 23 Sep 2026</div>
        </div>
        <div style="text-align:right">
          <div class="result-val">8.4 mmol/L</div>
          <div class="result-flag">⚑ Flagged for review</div>
        </div>
      </div>
      <div class="result-row" style="border:1px solid var(--line); padding:10px; border-radius:4px;">
        <div>
          <div class="result-name">Ferritin - S.T.</div>
          <div class="result-ref">12-150 ng/mL · 10 Sep 2026</div>
        </div>
        <div style="text-align:right">
          <div class="result-val">9 ng/mL</div>
          <div class="result-flag">⚑ Flagged for review</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="addPatientModal" style="display:none; position:fixed; inset:0; background:rgba(15,34,54,0.4); z-index:9000; align-items:center; justify-content:center; backdrop-filter:blur(2px);">
  <div style="background:white; border-radius:var(--radius); width:400px; padding:20px; box-shadow:var(--shadow-lg);">
    <h3 style="margin-bottom:15px; color:var(--navy); font-family:Manrope,sans-serif;">Add New Patient</h3>
    <form id="addPatientForm" onsubmit="submitAddPatient(event)" style="display:flex; flex-direction:column; gap:12px;">
      <div class="form-group"><label>Patient Initials</label><input type="text" id="ap-initials" required></div>
      <div class="form-group"><label>Date of Birth</label><input type="date" id="ap-dob" required></div>
      <div class="form-group"><label>Primary Concern</label><input type="text" id="ap-concern" required></div>
      <div class="form-group"><label>Allergies</label><textarea id="ap-allergies" rows="2"></textarea></div>
      <div class="form-group"><label>Referring Doctor</label><input type="text" id="ap-referring"></div>
      <div class="btn-row" style="justify-content:flex-end;">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('addPatientModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Add Patient</button>
      </div>
    </form>
  </div>
</div>
<script>
function submitAddPatient(e) {
  e.preventDefault();
  const initials = document.getElementById('ap-initials').value.toUpperCase();
  const dob = document.getElementById('ap-dob').value;
  const concern = document.getElementById('ap-concern').value;
  
  const tr = document.createElement('tr');
  tr.className = 'patient-row';
  tr.innerHTML = `
    <td>
      <div class="patient-name-cell">
        <div class="patient-avatar-sm" aria-hidden="true">${initials.substring(0,2)}</div>
        <div><strong>${initials}</strong><br><small style="color:var(--muted);font-size:10px">Patient ID: New</small></div>
      </div>
    </td>
    <td>${dob}</td>
    <td>New Patient</td>
    <td>Pending</td>
    <td><span class="concern-tag">${concern}</span></td>
    <td><span class="badge badge-amber">Intake Pending</span></td>
    <td><button class="btn btn-sm btn-ghost" onclick="event.stopPropagation();">View →</button></td>
  `;
  document.getElementById('patientTableBody').prepend(tr);
  document.getElementById('addPatientModal').style.display='none';
  showPreviewMsg(null, 'Patient ' + initials + ' added successfully.');
  e.target.reset();
}
</script>


<!-- ════════════════════════════════════════════════════════
     PATIENT CHART DRAWER
═════════════════════════════════════════════════════════ -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeChart()" aria-hidden="true"></div>

<aside class="chart-drawer" id="chartDrawer"
       role="dialog" aria-modal="true" aria-labelledby="drawerTitle"
       aria-describedby="drawerDisclaimer">
  <div class="drawer-head">
    <div class="clinician-avatar" id="drawerAvatar" aria-hidden="true">RD</div>
    <div>
      <h2 id="drawerTitle">Patient Chart</h2>
      <small id="drawerSubtitle">Loading…</small>
    </div>
    <button class="drawer-close" onclick="closeChart()" aria-label="Close patient chart">✕</button>
  </div>
  <div class="drawer-body" id="drawerBody">
    <!-- Populated by JS -->
  </div>
</aside>

<!-- ════════════════════════════════════════════════════════
     PREVIEW TOAST (global)
═════════════════════════════════════════════════════════ -->
<div id="globalToast" role="status" aria-live="polite" style="
  display:none;
  position:fixed;bottom:24px;right:24px;z-index:200;
  background:#17324d;color:white;
  font-size:12px;padding:14px 20px;border-radius:8px;
  box-shadow:0 8px 32px rgba(0,0,0,.2);
  max-width:360px;line-height:1.55;
">
  ℹ Preview only — no action is taken. This interface is not connected to any clinical system.
</div>

<!-- ════════════════════════════════════════════════════════
     JAVASCRIPT
═════════════════════════════════════════════════════════ -->
<script>
'use strict';

/* ── Section labels for top bar ─────────────────────────── */
const SECTION_LABELS = {
  dashboard:  'Dashboard — Today\'s Overview',
  patients:   'Patient List — Sample Data',
  encounter:  'Encounter Workspace — SOAP Note',
  trials:     'Trial Discovery — ClinicalTrials.gov (Sample)',
  referrals:  'Referrals — Outgoing Tracker',
  tasks:      'Follow-Up Tasks — Action List',
};

/* ── Switch visible section ─────────────────────────────── */
function switchSection(id, btn) {
  // Hide all sections
  document.querySelectorAll('.section-view').forEach(s => {
    s.classList.remove('active');
    s.setAttribute('aria-hidden', 'true');
  });
  // Show target
  const target = document.getElementById('section-' + id);
  if (target) {
    target.classList.add('active');
    target.removeAttribute('aria-hidden');
    target.focus && target.setAttribute('tabindex','-1');
  }

  // Update nav items
  document.querySelectorAll('.nav-item').forEach(n => {
    n.classList.remove('active');
    n.removeAttribute('aria-current');
  });
  // Find the matching button (could be passed directly or be a nav-item)
  const navBtn = document.querySelector(`.nav-item[data-section="${id}"]`);
  if (navBtn) {
    navBtn.classList.add('active');
    navBtn.setAttribute('aria-current', 'page');
  }

  // Update topbar label
  document.getElementById('active-section-label').textContent = SECTION_LABELS[id] || '';

  // Close mobile sidebar
  closeMobileSidebar();

  // Scroll to top
  document.getElementById('pageContent').scrollTop = 0;
}

/* ── Mobile sidebar ─────────────────────────────────────── */
function toggleMobileSidebar() {
  const sidebar = document.getElementById('sidebar');
  const btn = document.getElementById('menuToggle');
  const isOpen = sidebar.classList.toggle('mobile-open');
  btn.setAttribute('aria-expanded', isOpen);
}
function closeMobileSidebar() {
  const sidebar = document.getElementById('sidebar');
  if (sidebar.classList.contains('mobile-open')) {
    sidebar.classList.remove('mobile-open');
    document.getElementById('menuToggle').setAttribute('aria-expanded', 'false');
  }
}

/* ── Global preview message ─────────────────────────────── */
let toastTimer = null;

// Dropdown toggle handling
document.addEventListener('click', function(e) {
  if (!e.target.closest('.topbar-btn')) {
    document.querySelectorAll('.dropdown-panel').forEach(p => p.classList.remove('show'));
  }
});

function showPreviewMsg(el, customMsg) {
  const toast = document.getElementById('globalToast');
  if(customMsg) toast.textContent = customMsg; else toast.textContent = 'ℹ Preview only — no action is taken. This interface is not connected to any clinical system.'; toast.style.display = 'block';
  if (toastTimer) clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { toast.style.display = 'none'; }, 4000);
}

/* ── SOAP actions ───────────────────────────────────────── */

function soapAction(type) {
  const toast = document.getElementById('soap-toast');
  const btn = event.currentTarget;
  const origText = btn.innerHTML;
  
  btn.innerHTML = (type === 'draft') ? '⏳ Saving...' : '⏳ Signing...';
  
  setTimeout(() => {
    btn.innerHTML = (type === 'draft') ? '✓ Saved' : '✓ Signed';
    toast.textContent = (type === 'draft') ? `Draft saved at ${new Date().toLocaleTimeString()}` : `Note signed successfully at ${new Date().toLocaleTimeString()}`;
    toast.classList.add('show');
    
    setTimeout(() => {
      btn.innerHTML = origText;
      toast.classList.remove('show');
    }, 4000);
  }, 800);
}


/* ── Patient filter ─────────────────────────────────────── */

function filterPatients(q) {
  const rows = document.querySelectorAll('#patientTableBody tr');
  const lower = q.toLowerCase();
  rows.forEach(row => {
    const nameCell = row.cells[0]?.textContent.toLowerCase() || '';
    const concernCell = row.cells[4]?.textContent.toLowerCase() || '';
    row.style.display = (nameCell.includes(lower) || concernCell.includes(lower)) ? '' : 'none';
  });
}
);
}

/* ── Trial search ───────────────────────────────────────── */

function trialSearch() {
  const condition = document.getElementById('trial-condition').value || 'Unknown Condition';
  const label = document.getElementById('trial-results-label');
  label.innerHTML = `<strong>Fetching results for: ${escHtml(condition)}...</strong>`;
  
  fetch('/api/v1/trials/search?condition=' + encodeURIComponent(condition))
    .then(res => res.ok ? res.json() : [])
    .then(data => {
      label.innerHTML = `<strong>Results for: ${escHtml(condition)}</strong>`;
      const container = document.getElementById('trialResults');
      if(data && data.length > 0) {
        container.innerHTML = data.map(trial => `
          <article class="trial-card">
            <div class="trial-card-head">
              <div>
                <div class="trial-nct">${escHtml(trial.nct_id || 'N/A')}</div>
                <h3 class="trial-title">${escHtml(trial.title || 'Untitled Trial')}</h3>
              </div>
              <span class="badge badge-green" style="white-space:nowrap;flex-shrink:0;">${escHtml(trial.status || 'Recruiting')}</span>
            </div>
            <div class="trial-meta">
              <span class="badge badge-teal">${escHtml(trial.phase || 'Phase Unknown')}</span>
            </div>
            <div class="trial-eligibility">
              <strong>Eligibility Summary</strong>
              ${escHtml(trial.eligibility || 'No summary available')}
            </div>
            <div class="trial-card-actions">
              <button class="btn btn-ghost btn-sm" onclick="trialAction('criteria')">📄 View Full Criteria</button>
              <button class="btn btn-secondary btn-sm" onclick="trialAction('save')">🔖 Save for Patient</button>
            </div>
          </article>
        `).join('');
      } else {
        container.innerHTML = '<p>No trials found for this condition.</p>';
      }
    })
    .catch(err => {
      label.innerHTML = `<strong>Error fetching trials</strong>`;
      console.error(err);
    });
}
function escHtml(s) {
  const d = document.createElement('div'); d.textContent = s; return d.innerHTML;
}

/* ── Trial card actions ─────────────────────────────────── */
function trialAction(type) {
  const toast = document.getElementById('trial-toast');
  if (type === 'save') {
    toast.textContent = '🔖 Preview only — trial saved to session view only. Not persisted. Study team must confirm eligibility before any patient contact.';
  } else {
    toast.textContent = '📄 Full criteria view is a preview placeholder. Verify current criteria at ClinicalTrials.gov before clinical use.';
  }
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 7000);
}

/* ── Task toggle ────────────────────────────────────────── */
function toggleTask(taskId, checkbox) {
  const item = document.getElementById(taskId);
  item.classList.toggle('done', checkbox.checked);
  const toast = document.getElementById('task-toast');
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 5000);
}

