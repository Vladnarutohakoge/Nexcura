      <!-- ══════════════════════════════════════════════════
           SECTION 3 — ENCOUNTER WORKSPACE (SOAP)
      ═══════════════════════════════════════════════════ -->
      <section class="section-view" id="section-encounter" aria-labelledby="encounter-heading">

        <div class="section-head">
          <span class="section-kicker">Clinical Documentation</span>
          <h2 id="encounter-heading">Encounter Workspace — SOAP Note <em class="sample-tag">Illustrative sample only</em></h2>
          <p>Draft a clinical SOAP note. Preview only — no data is saved or transmitted.</p>
        </div>

        <div class="notice notice-warn" role="note">
          <strong>⚠ Preview Mode</strong>
          This is a demonstration interface. Nothing entered here is stored, transmitted, or connected to any clinical system.
        </div>

        <div class="soap-layout">
          <!-- SOAP Editor -->
          <div>
            <div class="card" style="margin-bottom:16px;">
              <div class="card-head">
                <h3>📝 SOAP Note — R.D. (24 Sep 2026)</h3>
                <span class="badge badge-slate">Draft</span>
              </div>
              <div class="card-body">

                <!-- Subjective -->
                <div class="soap-block">
                  <div class="soap-section-label">
                    <div class="soap-letter" aria-hidden="true">S</div>
                    <label for="soap-s">Subjective</label>
                    <em>Patient's chief complaint and history</em>
                  </div>
                  <div class="form-group">
                    <textarea id="soap-s" class="soap-field"
                              rows="4"
                              placeholder="Patient reports… e.g. Patient R.D. presents for annual review. Reports intermittent fatigue and increased thirst over past 3 weeks. Denies chest pain or dyspnoea. Last HbA1c was 7.2% (3 months ago)."
                              aria-label="Subjective: patient complaint and history"></textarea>
                  </div>
                </div>

                <hr class="divider"/>

                <!-- Objective -->
                <div class="soap-block">
                  <div class="soap-section-label">
                    <div class="soap-letter" style="background:#17324d;" aria-hidden="true">O</div>
                    <label for="soap-o">Objective</label>
                    <em>Examination findings and vital signs</em>
                  </div>
                  <div class="form-group">
                    <textarea id="soap-o" class="soap-field"
                              rows="4"
                              placeholder="Vitals: BP 138/86 mmHg, HR 78 bpm, Temp 36.7°C, O2 Sat 98%&#10;Exam: Alert and oriented. Abdomen soft, non-tender…"
                              aria-label="Objective: examination findings and vital signs"></textarea>
                  </div>
                </div>

                <hr class="divider"/>

                <!-- Assessment -->
                <div class="soap-block">
                  <div class="soap-section-label">
                    <div class="soap-letter" style="background:#247A52;" aria-hidden="true">A</div>
                    <label for="soap-a">Assessment</label>
                    <em>Clinical impression and differential</em>
                  </div>
                  <div class="form-group">
                    <textarea id="soap-a" class="soap-field"
                              rows="3"
                              placeholder="1. Type 2 Diabetes Mellitus — suboptimally controlled, HbA1c trending upward.&#10;2. Hypertension — borderline control, consider medication adjustment…"
                              aria-label="Assessment: clinical impression and differential"></textarea>
                  </div>
                </div>

                <hr class="divider"/>

                <!-- Plan -->
                <div class="soap-block">
                  <div class="soap-section-label">
                    <div class="soap-letter" style="background:#935900;" aria-hidden="true">P</div>
                    <label for="soap-p">Plan</label>
                    <em>Next steps, prescriptions, referrals</em>
                  </div>
                  <div class="form-group">
                    <textarea id="soap-p" class="soap-field"
                              rows="4"
                              placeholder="1. Repeat HbA1c in 6 weeks.&#10;2. Adjust Metformin dosage — increase to 1000 mg BD if tolerated.&#10;3. Dietary counselling referral.&#10;4. Blood pressure monitoring diary — review in 4 weeks.&#10;5. Trial match flag raised — refer to study coordinator."
                              aria-label="Plan: next steps and follow-up actions"></textarea>
                  </div>
                </div>

                <hr class="divider"/>

                <div class="btn-row">
                  <button class="btn btn-ghost" onclick="soapAction('draft')">💾 Save Draft</button>
                  <button class="btn btn-primary" onclick="soapAction('sign')">✏️ Sign Note</button>
                </div>
                <div class="inline-toast" id="soap-toast" role="status" aria-live="polite">
                  ℹ Preview only — no note is saved, signed, or transmitted. This interface is not connected to a clinical system.
                </div>
              </div>
            </div>
          </div>

          <!-- Intake Review Panel -->
          <aside aria-label="Patient intake review">
            <div class="intake-panel">
              <div class="intake-panel-head">
                📋 Pre-Visit Intake — R.D.
                <span class="sample-tag">Sample</span>
              </div>
              <div class="intake-panel-body">
                <p style="font-size:10px;color:var(--muted);margin-bottom:12px;">Submitted: 23 Sep 2026 · 09:42 AM</p>

                <div class="intake-q">
                  <strong>Chief complaint today</strong>
                  <p>Feeling more tired than usual and drinking a lot more water. A bit worried about my blood sugar.</p>
                </div>
                <div class="intake-q">
                  <strong>Symptom severity (1–10)</strong>
                  <p>Fatigue: 6/10 · Thirst: 7/10 · No pain</p>
                </div>
                <div class="intake-q">
                  <strong>Any changes to medications?</strong>
                  <p>No changes. Still taking Metformin 500 mg twice daily as prescribed.</p>
                </div>
                <div class="intake-q">
                  <strong>Recent blood glucose readings</strong>
                  <p>Morning readings averaging 8.4 mmol/L over last week. One reading of 11.2 mmol/L after a large meal.</p>
                </div>
                <div class="intake-q">
                  <strong>Any new symptoms or concerns?</strong>
                  <p>Occasional mild blurred vision in the evenings. No chest pain, no shortness of breath.</p>
                </div>
                <div class="intake-q">
                  <strong>Questions for doctor</strong>
                  <p>Should I adjust my diet? Is there a new medication option? Saw something about a clinical study.</p>
                </div>

                <div style="background:#f5f9f5;border-radius:4px;padding:10px;font-size:10px;color:var(--muted);margin-top:10px;line-height:1.6;">
                  ⚠ <strong style="color:var(--navy)">Illustrative sample only.</strong> This intake form content is entirely fictional and is not connected to any patient, EHR, or clinical record.
                </div>
              </div>
            </div>
          </aside>
        </div>

      </section><!-- /encounter -->

      <!-- ══════════════════════════════════════════════════
           SECTION 4 — TRIAL DISCOVERY
      ═══════════════════════════════════════════════════ -->
      <section class="section-view" id="section-trials" aria-labelledby="trials-heading">

        <div class="section-head">
          <span class="section-kicker">Research Matching</span>
          <h2 id="trials-heading">Clinical Trial Discovery <em class="sample-tag">Illustrative sample only</em></h2>
        </div>

        <!-- Prominent Trial Disclaimer -->
        <div class="trial-disclaimer" role="note" aria-label="Clinical trial disclaimer">
          <strong>⚠ Important — Preliminary Match Only</strong>
          <p>
            Results below are <strong>illustrative samples only</strong> and are not sourced in real time from ClinicalTrials.gov.
            <strong>The study team must confirm all eligibility criteria</strong> before a patient is enrolled or approached.
            Clinician discretion is required at all stages. These trial summaries do <strong>not</strong> constitute a referral or enrolment.
            Always verify against current data at <strong>ClinicalTrials.gov</strong> before presenting options to patients.
          </p>
        </div>

        <!-- Search Form -->
        <div class="card" style="margin-bottom:20px;">
          <div class="card-head"><h3>🔍 Search Trials</h3></div>
          <div class="card-body">
            <form onsubmit="event.preventDefault();trialSearch();" aria-label="Trial search form">
              <div class="trial-search-bar">
                <div class="form-group">
                  <label for="trial-condition">Condition / Keyword</label>
                  <input id="trial-condition" type="text" value="Type 2 Diabetes" placeholder="e.g. Hypertension, Oncology…" aria-required="true"/>
                </div>
                <div class="form-group">
                  <label for="trial-phase">Trial Phase</label>
                  <select id="trial-phase">
                    <option value="">All Phases</option>
                    <option value="1">Phase I</option>
                    <option selected value="2">Phase II</option>
                    <option value="3">Phase III</option>
                    <option value="4">Phase IV</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="trial-location">Location</label>
                  <input id="trial-location" type="text" value="London, UK" placeholder="City or Country…"/>
                </div>
                <div class="form-group">
                  <label style="color:transparent" aria-hidden="true">Search</label>
                  <button class="btn btn-primary" type="submit">Search Trials</button>
                </div>
              </div>
              <p style="font-size:10px;color:var(--muted);">Source: ClinicalTrials.gov (illustrative) · Last verified: 15 Sep 2026</p>
            </form>
          </div>
        </div>

        <!-- Results Notice -->
        <div class="notice notice-info" role="status" id="trial-results-label">
          <strong>2 Illustrative Results for: Type 2 Diabetes — Phase II — London, UK</strong>
          These are sample trial cards for interface demonstration. They do not represent live search results.
        </div>

        <!-- Trial Cards -->
        <div id="trialResults">

          <!-- Trial 1 -->
          <article class="trial-card" aria-label="Trial: NCT04832167">
            <div class="trial-card-head">
              <div>
                <div class="trial-nct">NCT04832167 <span class="sample-tag">Illustrative sample</span></div>
                <h3 class="trial-title">GLUCO-PRIME II: Phase II Study of Novel GLP-1 Receptor Agonist in Adults with Suboptimally Controlled Type 2 Diabetes</h3>
              </div>
              <span class="badge badge-green" style="white-space:nowrap;flex-shrink:0;">Recruiting</span>
            </div>
            <div class="trial-meta">
              <span class="badge badge-teal">Phase II</span>
              <span class="badge badge-slate">Randomised · Double-Blind</span>
              <span class="badge badge-slate">🏥 NexResearch Centre, London (Illustrative)</span>
            </div>
            <div class="trial-eligibility">
              <strong>Eligibility Summary (patient-reported — study team confirms)</strong>
              Inclusion: Adults 30–75 years · Diagnosed T2DM ≥ 12 months · HbA1c 7.0–10.0% · BMI 25–40 kg/m² · Currently on stable oral therapy.
              Exclusion: Type 1 diabetes · Renal impairment (eGFR &lt;45) · Pregnancy/breastfeeding · Prior GLP-1 therapy · Active malignancy.
            </div>
            <div class="trial-source">
              Source: ClinicalTrials.gov (Illustrative) · Verified: 15 Sep 2026 · Sponsor: Sample Pharma Research Ltd.
            </div>
            <div class="trial-card-actions">
              <button class="btn btn-ghost btn-sm" onclick="trialAction('criteria')">📄 View Full Criteria</button>
              <button class="btn btn-secondary btn-sm" onclick="trialAction('save')">🔖 Save for Patient</button>
            </div>
          </article>

          <!-- Trial 2 -->
          <article class="trial-card" aria-label="Trial: NCT05210483">
            <div class="trial-card-head">
              <div>
                <div class="trial-nct">NCT05210483 <span class="sample-tag">Illustrative sample</span></div>
                <h3 class="trial-title">CARDIO-DIAB: Cardiovascular Outcomes in Adults with T2DM and Hypertension — Phase II/III Multi-site Cohort</h3>
              </div>
              <span class="badge badge-green" style="white-space:nowrap;flex-shrink:0;">Recruiting</span>
            </div>
            <div class="trial-meta">
              <span class="badge badge-teal">Phase II / III</span>
              <span class="badge badge-slate">Observational · Prospective</span>
              <span class="badge badge-slate">🏥 Multi-site UK (Illustrative)</span>
            </div>
            <div class="trial-eligibility">
              <strong>Eligibility Summary (patient-reported — study team confirms)</strong>
              Inclusion: Adults ≥ 40 years · T2DM + Hypertension co-diagnosis · Systolic BP 130–160 mmHg at enrolment · No cardiac event in last 6 months.
              Exclusion: Unstable angina · Current participation in another cardiovascular trial · Severe hepatic impairment.
            </div>
            <div class="trial-source">
              Source: ClinicalTrials.gov (Illustrative) · Verified: 15 Sep 2026 · Sponsor: UK Academic Health Research Consortium (Sample)
            </div>
            <div class="trial-card-actions">
              <button class="btn btn-ghost btn-sm" onclick="trialAction('criteria')">📄 View Full Criteria</button>
              <button class="btn btn-secondary btn-sm" onclick="trialAction('save')">🔖 Save for Patient</button>
            </div>
          </article>

        </div><!-- /trialResults -->

        <div class="inline-toast" id="trial-toast" role="status" aria-live="polite"></div>

        <div class="disclaimer-box" style="margin-top:20px;">
          <strong>⚠ Clinical Trial Use Disclaimer</strong>
          Preliminary match only. Study team confirms eligibility. These are illustrative samples — verify against current ClinicalTrials.gov data before presenting to patients or initiating any referral process. NexCura does not guarantee accuracy of trial information shown here.
        </div>

      </section><!-- /trials -->

      <!-- ══════════════════════════════════════════════════
           SECTION 5 — REFERRALS
      ═══════════════════════════════════════════════════ -->
      <section class="section-view" id="section-referrals" aria-labelledby="referrals-heading">

        <div class="section-head">
          <span class="section-kicker">Care Coordination</span>
          <h2 id="referrals-heading">Outgoing Referrals <em class="sample-tag">Illustrative sample only</em></h2>
          <p>Track referrals initiated by Dr. A. Mehta. All patient identifiers are anonymised.</p>
        </div>

        <div class="notice notice-warn" role="note">
          <strong>⚠ Sample Data</strong>
          All referral data shown is fictional and for interface demonstration only. Not connected to any referral management system or clinical network.
        </div>

        <!-- Filter Tabs -->
        <div class="filter-tabs" role="tablist" aria-label="Filter referrals by status">
          <button class="filter-tab active" role="tab" aria-selected="true" id="ref-tab-all"
                  onclick="filterReferrals('all', this)">All (4)</button>
          <button class="filter-tab" role="tab" aria-selected="false" id="ref-tab-pending"
                  onclick="filterReferrals('pending', this)">Pending (2)</button>
          <button class="filter-tab" role="tab" aria-selected="false" id="ref-tab-accepted"
                  onclick="filterReferrals('accepted', this)">Accepted (1)</button>
          <button class="filter-tab" role="tab" aria-selected="false" id="ref-tab-closed"
                  onclick="filterReferrals('closed', this)">Closed (1)</button>
        </div>

        <div class="card">
          <div class="card-head">
            <h3>Referral Tracker</h3>
            <button class="btn btn-primary btn-sm" onclick="showPreviewMsg(this)">+ New Referral</button>
          </div>
          <div class="card-body" style="padding:0">
            <div class="table-wrap">
              <table id="referralTable" aria-label="Referral list — sample data">
                <thead>
                  <tr>
                    <th scope="col">Ref. #</th>
                    <th scope="col">Patient (Anon.)</th>
                    <th scope="col">Referring Doctor</th>
                    <th scope="col">Specialty</th>
                    <th scope="col">Reason</th>
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody id="referralBody">
                  <tr data-status="accepted">
                    <td><strong>#REF-2611</strong></td>
                    <td>Patient A</td>
                    <td>Dr. A. Mehta</td>
                    <td>Endocrinology</td>
                    <td>T2DM complication review</td>
                    <td>10 Sep 2026</td>
                    <td><span class="badge badge-green">Accepted</span></td>
                    <td><button class="btn btn-sm btn-ghost" onclick="openRefModal(this)">Details</button></td>
                  </tr>
                  <tr data-status="pending">
                    <td><strong>#REF-2654</strong></td>
                    <td>Patient B</td>
                    <td>Dr. A. Mehta</td>
                    <td>Cardiology</td>
                    <td>Hypertension + arrhythmia concern</td>
                    <td>15 Sep 2026</td>
                    <td><span class="badge badge-amber">Pending</span></td>
                    <td><button class="btn btn-sm btn-ghost" onclick="openRefModal(this)">Details</button></td>
                  </tr>
                  <tr data-status="pending">
                    <td><strong>#REF-2701</strong></td>
                    <td>Patient C</td>
                    <td>Dr. A. Mehta</td>
                    <td>Dietetics</td>
                    <td>Nutritional counselling — DM management</td>
                    <td>20 Sep 2026</td>
                    <td><span class="badge badge-amber">Pending</span></td>
                    <td><button class="btn btn-sm btn-ghost" onclick="openRefModal(this)">Details</button></td>
                  </tr>
                  <tr data-status="closed">
