<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Clinical Workspace — NexCura</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ─── RESET & TOKENS ─────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --teal:          #0b5d5e;
      --teal-light:    #e4f1ee;
      --navy:          #17324d;
      --navy-dark:     #0f2236;
      --navy-mid:      #1e4266;
      --mint:          #dff1e9;
      --cream:         #fafaf6;
      --ink:           #183537;
      --muted:         #657779;
      --line:          #e5ebe5;
      --alert-red:     #B42318;
      --alert-bg:      #fdf2f2;
      --success-green: #247A52;
      --success-bg:    #edf7f2;
      --amber:         #F2B95E;
      --amber-bg:      #fff8eb;
      --slate-bg:      #f1f3f6;
      --slate-text:    #5a6378;
      --sidebar-w:     220px;
      --topbar-h:      62px;
      --radius:        6px;
      --shadow:        0 4px 18px rgba(18,60,62,.10);
      --shadow-lg:     0 12px 40px rgba(18,60,62,.15);
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      font-size: 13px;
      line-height: 1.6;
    }
    a { color: inherit; text-decoration: none; }
    button, select, input, textarea { font: inherit; }
    h1, h2, h3, h4 { font-family: Manrope, sans-serif; line-height: 1.2; }
    ul { list-style: none; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    /* ─── DEMO BANNER ────────────────────────────────────────────── */
    .demo-banner {
      background: #1b2840;
      color: #f0c96b;
      font-size: 11px;
      font-weight: 700;
      text-align: center;
      padding: 9px 20px;
      letter-spacing: .04em;
      line-height: 1.5;
      z-index: 100;
      position: relative;
    }
    .demo-banner span { color: #a9c8e0; font-weight: 400; margin-left: 8px; }

    /* ─── APP SHELL ──────────────────────────────────────────────── */
    .app-shell {
      display: flex;
      min-height: 100vh;
    }

    /* ─── SIDEBAR ────────────────────────────────────────────────── */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--navy);
      color: #c8dce8;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 50;
      transition: transform .28s ease;
    }
    .sidebar-brand {
      padding: 22px 18px 18px;
      border-bottom: 1px solid rgba(255,255,255,.08);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .brand-mark-sm {
      width: 28px; height: 28px;
      border: 1.8px solid #6bafc8;
      border-radius: 50%;
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .brand-mark-sm::before, .brand-mark-sm::after {
      content: ''; position: absolute; background: #6bafc8; border-radius: 4px;
    }
    .brand-mark-sm::before { width: 2px; height: 14px; }
    .brand-mark-sm::after  { height: 2px; width: 14px; }
    .sidebar-brand-name {
      font-family: Manrope, sans-serif;
      font-size: 18px;
      font-weight: 800;
      color: #fff;
      letter-spacing: -1px;
    }
    .sidebar-brand-name em { font-style: normal; color: #7bbfd4; font-weight: 500; }

    .clinician-card {
      margin: 16px 14px 12px;
      background: var(--navy-mid);
      border-radius: var(--radius);
      padding: 13px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .clinician-avatar {
      width: 38px; height: 38px;
      border-radius: 50%;
      background: var(--teal);
      color: white;
      font-weight: 700;
      font-size: 13px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      font-family: Manrope, sans-serif;
    }
    .clinician-info small { display: block; font-size: 9px; color: #8baab8; letter-spacing: .06em; }
    .clinician-info strong { display: block; color: #ddeef5; font-size: 11px; font-family: Manrope, sans-serif; margin-top: 2px; }
    .clinician-info span { display: block; font-size: 9px; color: #6fa3bc; margin-top: 1px; }

    .sidebar-nav { flex: 1; padding: 8px 0; overflow-y: auto; }
    .nav-section-label {
      font-size: 8px;
      letter-spacing: .12em;
      color: #5a7f97;
      font-weight: 700;
      padding: 14px 18px 5px;
      text-transform: uppercase;
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 18px;
      cursor: pointer;
      border-radius: 0;
      color: #9cbfd2;
      font-size: 12px;
      font-weight: 500;
      transition: background .18s, color .18s;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
      position: relative;
    }
    .nav-item:hover { background: rgba(255,255,255,.06); color: #daeef7; }
    .nav-item.active { background: rgba(255,255,255,.10); color: #fff; font-weight: 700; }
    .nav-item.active::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      background: var(--amber);
      border-radius: 0 2px 2px 0;
    }
    .nav-item:focus-visible { outline: 2px solid var(--amber); outline-offset: -2px; }
    .nav-icon { font-size: 16px; width: 20px; text-align: center; flex-shrink: 0; }
    .nav-badge {
      margin-left: auto;
      background: var(--alert-red);
      color: white;
      font-size: 9px;
      font-weight: 700;
      border-radius: 10px;
      padding: 2px 6px;
      min-width: 18px;
      text-align: center;
    }
    .nav-badge.amber { background: var(--amber); color: #5a3a00; }

    .sidebar-footer {
      padding: 14px 18px;
      border-top: 1px solid rgba(255,255,255,.08);
      font-size: 10px;
      color: #5a7f97;
    }
    .sidebar-footer a { color: #6fa3bc; }
    .sidebar-footer a:hover { color: #daeef7; }

    /* ─── MAIN AREA ──────────────────────────────────────────────── */
    .main-area {
      flex: 1;
      margin-left: var(--sidebar-w);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* ─── TOP BAR ────────────────────────────────────────────────── */
    .topbar {
      height: var(--topbar-h);
      background: white;
      border-bottom: 1px solid var(--line);
      padding: 0 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
      box-shadow: 0 1px 0 var(--line);
    }
    .topbar-title { font-family: Manrope, sans-serif; font-size: 15px; font-weight: 700; color: var(--navy); }
    .topbar-title small { display: block; font-family: 'DM Sans', sans-serif; font-size: 10px; color: var(--muted); font-weight: 400; margin-top: 1px; }
    .topbar-actions { display: flex; align-items: center; gap: 14px; }
    .topbar-btn {
      background: none;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 7px 13px;
      font-size: 11px;
      color: var(--ink);
      cursor: pointer;
      transition: background .15s;
    }
    .topbar-btn:hover { background: var(--mint); }
    .topbar-btn:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
    .menu-toggle-btn {
      display: none;
      background: none;
      border: none;
      font-size: 22px;
      color: var(--navy);
      cursor: pointer;
      padding: 4px;
    }
    .menu-toggle-btn:focus-visible { outline: 2px solid var(--teal); }

    /* ─── PAGE CONTENT ───────────────────────────────────────────── */
    .page-content { flex: 1; padding: 28px; overflow: auto; }
    .section-view { display: none; }
    .section-view.active { display: block; }

    /* ─── SECTION HEADINGS ───────────────────────────────────────── */
    .section-head { margin-bottom: 22px; }
    .section-head h2 { font-size: 22px; color: var(--navy); margin-bottom: 4px; }
    .section-head p { color: var(--muted); font-size: 12px; }
    .section-kicker {
      font-size: 9px;
      letter-spacing: .12em;
      font-weight: 700;
      color: var(--teal);
      text-transform: uppercase;
      margin-bottom: 6px;
      display: block;
    }

    /* ─── CARDS & PANELS ─────────────────────────────────────────── */
    .card {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .card-pad { padding: 20px; }
    .card-head {
      padding: 16px 20px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .card-head h3 { font-size: 14px; color: var(--navy); }
    .card-body { padding: 18px 20px; }

    /* ─── BADGES / STATUS CHIPS ──────────────────────────────────── */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 12px;
      font-size: 10px;
      font-weight: 700;
      vertical-align: middle;
    }
    .badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; display: inline-block; }
    .badge-green  { background: var(--success-bg); color: var(--success-green); }
    .badge-green::before  { background: var(--success-green); }
    .badge-amber  { background: var(--amber-bg); color: #935900; }
    .badge-amber::before  { background: var(--amber); }
    .badge-slate  { background: var(--slate-bg); color: var(--slate-text); }
    .badge-slate::before  { background: #a0aabb; }
    .badge-red    { background: var(--alert-bg); color: var(--alert-red); }
    .badge-red::before    { background: var(--alert-red); }
    .badge-teal   { background: var(--teal-light); color: var(--teal); }
    .badge-teal::before   { background: var(--teal); }

    /* ─── BUTTONS ────────────────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 16px;
      border-radius: var(--radius);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      border: none;
      transition: opacity .15s, transform .12s;
    }
    .btn:hover { opacity: .88; transform: translateY(-1px); }
    .btn:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
    .btn:active { transform: translateY(0); }
    .btn-primary { background: var(--teal); color: white; }
    .btn-secondary { background: var(--teal-light); color: var(--teal); }
    .btn-ghost { background: none; border: 1px solid var(--line); color: var(--ink); }
    .btn-danger { background: var(--alert-bg); color: var(--alert-red); border: 1px solid #f5c6c3; }
    .btn-sm { padding: 6px 11px; font-size: 11px; }
    .btn-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }

    /* ─── ALERT NOTICES ──────────────────────────────────────────── */
    .notice {
      border-radius: var(--radius);
      padding: 12px 16px;
      font-size: 11px;
      line-height: 1.65;
      border-left: 4px solid transparent;
      margin-bottom: 14px;
    }
    .notice-warn { background: var(--amber-bg); border-color: var(--amber); color: #735900; }
    .notice-info { background: #e8f4fb; border-color: #5da8cc; color: #1a4f6e; }
    .notice-error { background: var(--alert-bg); border-color: var(--alert-red); color: #7a1810; }
    .notice-success { background: var(--success-bg); border-color: var(--success-green); color: #145038; }
    .notice strong { display: block; font-size: 12px; margin-bottom: 3px; }

    /* ─── INLINE TOAST ───────────────────────────────────────────── */
    .inline-toast {
      display: none;
      background: var(--amber-bg);
      border: 1px solid var(--amber);
      color: #735900;
      font-size: 11px;
      padding: 8px 13px;
      border-radius: var(--radius);
      margin-top: 10px;
    }
    .inline-toast.show { display: block; }

    /* ─── TABLES ─────────────────────────────────────────────────── */
    .table-wrap { overflow-x: auto; }
    table {
      border-collapse: collapse;
      width: 100%;
      font-size: 12px;
    }
    th {
      text-align: left;
      padding: 10px 14px;
      border-bottom: 2px solid var(--line);
      color: var(--muted);
      font-size: 10px;
      letter-spacing: .06em;
      font-weight: 700;
      text-transform: uppercase;
      background: #f8faf8;
    }
    td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      vertical-align: middle;
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #f5faf8; }

    /* ─── FORMS ──────────────────────────────────────────────────── */
    .form-group { display: grid; gap: 5px; }
    .form-group label { font-size: 11px; font-weight: 700; color: var(--muted); }
    .form-group input,
    .form-group select,
    .form-group textarea {
      border: 1px solid #d4dfd4;
      border-radius: var(--radius);
      padding: 10px 12px;
      color: var(--ink);
      background: white;
      font-size: 12px;
    }
    .form-group textarea { resize: vertical; min-height: 100px; }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: 2px solid var(--teal);
      outline-offset: 1px;
      border-color: var(--teal);
    }
    .form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .form-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }

    /* ─── DISCLAIMER BOX ─────────────────────────────────────────── */
    .disclaimer-box {
      background: #fff8eb;
      border: 2px solid var(--amber);
      border-radius: var(--radius);
      padding: 14px 18px;
      font-size: 11px;
      line-height: 1.7;
      color: #5a3c00;
    }
    .disclaimer-box strong { display: block; font-size: 13px; color: #3a2700; margin-bottom: 4px; }
    .disclaimer-box.red-border { border-color: var(--alert-red); background: var(--alert-bg); color: #7a1810; }
    .disclaimer-box.red-border strong { color: var(--alert-red); }

    /* ─── GRID LAYOUTS ───────────────────────────────────────────── */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }

    /* ─── DASHBOARD ──────────────────────────────────────────────── */
    .metric-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
    .metric-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px 18px 14px;
      box-shadow: var(--shadow);
    }
    .metric-card .metric-icon {
      width: 36px; height: 36px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 18px;
      margin-bottom: 12px;
    }
    .metric-card .metric-value { font-family: Manrope, sans-serif; font-size: 28px; font-weight: 800; color: var(--navy); }
    .metric-card .metric-label { font-size: 11px; color: var(--muted); margin-top: 3px; }
    .metric-card .metric-tag { margin-top: 8px; }
    .icon-teal   { background: var(--teal-light); color: var(--teal); }
    .icon-amber  { background: var(--amber-bg); color: #835500; }
    .icon-red    { background: var(--alert-bg); color: var(--alert-red); }
    .icon-navy   { background: #e4eaf5; color: var(--navy); }

    .schedule-list { display: grid; gap: 8px; }
    .schedule-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: var(--radius);
      border: 1px solid var(--line);
      background: #fafcfa;
    }
    .schedule-time {
      font-size: 11px;
      font-weight: 700;
      color: var(--teal);
      min-width: 48px;
      text-align: center;
    }
    .schedule-sep { width: 1px; height: 36px; background: var(--line); }
    .schedule-info strong { display: block; font-size: 12px; color: var(--navy); }
    .schedule-info span  { display: block; font-size: 10px; color: var(--muted); }
    .schedule-item .badge { margin-left: auto; }

    .quick-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .qa-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px 16px;
      cursor: pointer;
      transition: box-shadow .18s, transform .18s;
      text-align: center;
    }
    .qa-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
    .qa-card:focus-visible { outline: 2px solid var(--teal); }
    .qa-icon { font-size: 26px; margin-bottom: 8px; display: block; }
    .qa-card strong { display: block; font-size: 13px; color: var(--navy); font-family: Manrope, sans-serif; margin-bottom: 4px; }
    .qa-card p { font-size: 10px; color: var(--muted); line-height: 1.5; }

    .alert-card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: white;
      border: 1px solid var(--line);
      border-left: 4px solid var(--alert-red);
      border-radius: var(--radius);
      padding: 14px 16px;
      margin-bottom: 10px;
    }
    .alert-card.amber { border-left-color: var(--amber); }
    .alert-card.teal { border-left-color: var(--teal); }
    .alert-icon { font-size: 20px; margin-top: 1px; }
    .alert-body strong { display: block; font-size: 12px; color: var(--navy); }
    .alert-body p { font-size: 11px; color: var(--muted); margin-top: 2px; }

    /* ─── PATIENT LIST ───────────────────────────────────────────── */
    .patient-row { cursor: pointer; }
    .patient-row:hover td { background: #f0f9f5; }
    .patient-name-cell { display: flex; align-items: center; gap: 10px; }
    .patient-avatar-sm {
      width: 30px; height: 30px;
      border-radius: 50%;
      background: var(--teal-light);
      color: var(--teal);
      display: grid;
      place-items: center;
      font-size: 11px;
      font-weight: 700;
      flex-shrink: 0;
    }
    .concern-tag {
      background: #f1f5f8;
      border-radius: 4px;
      padding: 2px 7px;
      font-size: 10px;
      color: var(--navy);
    }

    /* ─── PATIENT CHART DRAWER ───────────────────────────────────── */
    .drawer-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 34, 54, .4);
      z-index: 60;
      backdrop-filter: blur(2px);
    }
    .drawer-overlay.open { display: block; }
    .chart-drawer {
      position: fixed;
      right: 0; top: 0; bottom: 0;
      width: min(680px, 92vw);
      background: white;
      z-index: 61;
      box-shadow: -6px 0 40px rgba(15,34,54,.18);
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform .28s cubic-bezier(.4,0,.2,1);
    }
    .chart-drawer.open { transform: translateX(0); }
    .drawer-head {
      padding: 18px 22px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      gap: 12px;
      background: var(--navy);
      color: white;
    }
    .drawer-head h2 { font-size: 16px; color: white; }
    .drawer-head small { display: block; font-size: 10px; color: #8baab8; margin-top: 2px; }
    .drawer-close {
      margin-left: auto;
      background: rgba(255,255,255,.12);
      border: none;
      color: white;
      width: 32px; height: 32px;
      border-radius: 50%;
      font-size: 18px;
      cursor: pointer;
      display: grid;
      place-items: center;
    }
    .drawer-close:hover { background: rgba(255,255,255,.22); }
    .drawer-close:focus-visible { outline: 2px solid var(--amber); }
    .drawer-body { flex: 1; overflow-y: auto; padding: 22px; }
    .drawer-disclaimer {
      background: #fff3cd;
      border: 2px dashed #d4a017;
      border-radius: var(--radius);
      text-align: center;
      padding: 10px 14px;
      font-size: 11px;
      font-weight: 700;
      color: #6b4c00;
      margin-bottom: 18px;
      letter-spacing: .03em;
    }
    .drawer-section { margin-bottom: 20px; }
    .drawer-section h4 {
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 700;
      margin-bottom: 10px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--line);
    }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .detail-item small { display: block; font-size: 10px; color: var(--muted); }
    .detail-item strong { display: block; font-size: 12px; color: var(--navy); margin-top: 2px; }
    .condition-tag {
      display: inline-block;
      background: var(--teal-light);
      color: var(--teal);
      border-radius: 4px;
      padding: 3px 8px;
      font-size: 10px;
      font-weight: 600;
      margin: 2px;
    }
    .med-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid var(--line);
      font-size: 11px;
    }
    .med-item:last-child { border-bottom: none; }
    .med-item .med-name { color: var(--navy); font-weight: 600; }
    .med-item .med-dose { color: var(--muted); font-size: 10px; }
    .allergy-badge {
      display: inline-block;
      background: var(--alert-bg);
      color: var(--alert-red);
      border-radius: 4px;
      padding: 3px 8px;
      font-size: 10px;
      font-weight: 700;
      margin: 2px;
    }
    .result-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 9px 0;
      border-bottom: 1px solid var(--line);
      font-size: 11px;
    }
    .result-row:last-child { border-bottom: none; }
    .result-name { color: var(--navy); font-weight: 600; }
    .result-val { font-size: 13px; font-weight: 700; color: var(--teal); }
    .result-ref { font-size: 9px; color: var(--muted); }
    .result-flag { color: var(--alert-red); font-size: 10px; font-weight: 700; }
    .encounter-item {
      display: flex;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--line);
      font-size: 11px;
    }
    .encounter-item:last-child { border-bottom: none; }
    .enc-date { min-width: 70px; color: var(--muted); font-size: 10px; }
    .enc-body strong { display: block; color: var(--navy); font-size: 12px; }
    .enc-body p { color: var(--muted); margin-top: 2px; }

    /* ─── ENCOUNTER WORKSPACE / SOAP ─────────────────────────────── */
    .soap-layout { display: grid; grid-template-columns: 1fr 340px; gap: 20px; align-items: start; }
    .soap-section-label {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .soap-letter {
      width: 26px; height: 26px;
      border-radius: 50%;
      background: var(--navy);
      color: white;
      font-family: Manrope, sans-serif;
      font-weight: 800;
      font-size: 13px;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }
    .soap-section-label label { font-weight: 700; font-size: 13px; color: var(--navy); }
    .soap-section-label em { font-style: normal; font-size: 10px; color: var(--muted); margin-left: 4px; }
    .soap-field { width: 100%; }
    .soap-block { margin-bottom: 18px; }
    .intake-panel { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
    .intake-panel-head { background: var(--navy); color: white; padding: 12px 16px; font-family: Manrope, sans-serif; font-size: 13px; font-weight: 700; }
    .intake-panel-body { padding: 16px; }
    .intake-q { margin-bottom: 12px; }
    .intake-q strong { display: block; font-size: 11px; color: var(--navy); margin-bottom: 2px; }
    .intake-q p { font-size: 11px; color: var(--ink); background: #f5faf8; border-radius: 4px; padding: 7px 10px; }

    /* ─── TRIAL DISCOVERY ────────────────────────────────────────── */
    .trial-disclaimer {
      background: #fff8eb;
      border: 2px solid var(--amber);
      border-radius: var(--radius);
      padding: 16px 20px;
      margin-bottom: 20px;
    }
    .trial-disclaimer strong { display: block; font-size: 14px; color: #5a3700; margin-bottom: 6px; font-family: Manrope, sans-serif; }
    .trial-disclaimer p { font-size: 11px; color: #735500; line-height: 1.7; }
    .trial-search-bar {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr auto;
      gap: 12px;
      align-items: end;
      margin-bottom: 22px;
    }
    .trial-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 20px;
      box-shadow: var(--shadow);
      margin-bottom: 16px;
    }
    .trial-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .trial-nct { font-size: 10px; color: var(--muted); font-weight: 700; letter-spacing: .05em; }
    .trial-title { font-family: Manrope, sans-serif; font-size: 15px; color: var(--navy); font-weight: 700; margin: 4px 0 8px; }
    .trial-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
    .trial-eligibility { background: #f5faf8; border-radius: 4px; padding: 10px 12px; font-size: 11px; color: var(--ink); line-height: 1.65; margin-bottom: 12px; }
    .trial-eligibility strong { display: block; font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 4px; }
    .trial-source { font-size: 9px; color: var(--muted); }
    .trial-card-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; margin-top: 14px; border-top: 1px solid var(--line); padding-top: 12px; }

    /* ─── REFERRALS ──────────────────────────────────────────────── */
    .filter-tabs { display: flex; gap: 4px; margin-bottom: 18px; }
    .filter-tab {
      padding: 7px 14px;
      border-radius: 20px;
      border: 1px solid var(--line);
      background: white;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      color: var(--muted);
      transition: background .15s, color .15s;
    }
    .filter-tab:hover { background: var(--mint); color: var(--teal); }
    .filter-tab.active { background: var(--navy); color: white; border-color: var(--navy); }
    .filter-tab:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }

    /* ─── FOLLOW-UP TASKS ────────────────────────────────────────── */
    .task-list { display: grid; gap: 10px; }
    .task-item {
      display: flex;
      align-items: flex-start;
      gap: 13px;
      padding: 14px 16px;
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 1px 4px rgba(18,60,62,.05);
      transition: background .15s;
    }
    .task-item.done { opacity: .6; }
    .task-item.done .task-title { text-decoration: line-through; }
    .task-check-wrap { padding-top: 2px; }
    .task-check {
      width: 18px; height: 18px;
      accent-color: var(--teal);
      cursor: pointer;
    }
    .task-check:focus-visible { outline: 2px solid var(--teal); }
    .task-info { flex: 1; }
    .task-title { font-size: 13px; font-weight: 600; color: var(--navy); display: block; margin-bottom: 3px; }
    .task-desc { font-size: 11px; color: var(--muted); }
    .task-meta { display: flex; align-items: center; gap: 8px; margin-top: 6px; flex-wrap: wrap; }
    .task-due { font-size: 10px; color: var(--muted); }
    .task-due.overdue { color: var(--alert-red); font-weight: 700; }
    .task-patient { font-size: 10px; color: var(--teal); font-weight: 600; }
    .priority-high { background: var(--alert-bg); color: var(--alert-red); }
    .priority-med  { background: var(--amber-bg); color: #835500; }
    .priority-low  { background: var(--success-bg); color: var(--success-green); }

    /* ─── SAMPLE DATA WATERMARK ──────────────────────────────────── */
    .sample-tag {
      display: inline-block;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .08em;
      padding: 2px 7px;
      background: #ffebd2;
      color: #7a4000;
      border-radius: 3px;
      text-transform: uppercase;
      margin-left: 6px;
      vertical-align: middle;
    }

    /* ─── DIVIDERS ───────────────────────────────────────────────── */
    .divider { border: none; border-top: 1px solid var(--line); margin: 18px 0; }

    /* ─── SIDEBAR OPEN/CLOSE MOBILE ──────────────────────────────── */
    @media (max-width: 768px) {
      :root { --sidebar-w: 0px; }
      .sidebar {
        transform: translateX(-220px);
        width: 220px;
      }
      .sidebar.mobile-open { transform: translateX(0); }
      .main-area { margin-left: 0; }
      .menu-toggle-btn { display: flex; }
      .metric-strip { grid-template-columns: 1fr 1fr; }
      .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
      .quick-actions { grid-template-columns: 1fr 1fr; }
      .trial-search-bar { grid-template-columns: 1fr 1fr; }
      .soap-layout { grid-template-columns: 1fr; }
      .form-grid-2, .form-grid-3 { grid-template-columns: 1fr; }
      .detail-grid { grid-template-columns: 1fr; }
      .page-content { padding: 18px; }
      .topbar { padding: 0 18px; }
    }
    @media (max-width: 480px) {
      .metric-strip { grid-template-columns: 1fr; }
      .quick-actions { grid-template-columns: 1fr; }
      .filter-tabs { flex-wrap: wrap; }
    }
  
    /* ─── ADDED BY PATCH ─────────────────────────────────────────── */
    .dropdown-panel.show { display: block !important; }
    @media print {
      body * { visibility: hidden; }
      #chartDrawer, #chartDrawer * { visibility: visible; }
      #chartDrawer { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none; transform: none; }
      .drawer-close, .btn-row { display: none !important; }
    }

  </style>
</head>
<body>

<!-- ─── LOGIN GATE ─────────────────────────────────────────────── -->
<div id="loginGate" style="display:flex;position:fixed;inset:0;z-index:9999;background:linear-gradient(135deg,#0d1b2a 0%,#17324d 50%,#0d1b2a 100%);align-items:center;justify-content:center;font-family:'DM Sans','Manrope',sans-serif;">
  <div style="background:#fff;border-radius:16px;padding:48px 40px;max-width:420px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.4);text-align:center;">
    <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#17324d,#2e5c8a);margin:0 auto 20px;display:flex;align-items:center;justify-content:center;">
      <span style="color:#fff;font-size:24px;font-weight:800;font-family:'Manrope',sans-serif;">NC</span>
    </div>
    <h1 style="font-family:'Manrope',sans-serif;font-size:1.5rem;color:#0d1b2a;margin:0 0 6px;">Clinical Workspace</h1>
    <p style="color:#5a6a72;font-size:0.9rem;margin:0 0 28px;">Enter your credentials to access the clinical workspace.</p>
    <form id="loginForm" onsubmit="return handleLogin(event)" autocomplete="off">
      <div style="text-align:left;margin-bottom:16px;">
        <label for="loginUser" style="display:block;font-size:0.8rem;font-weight:600;color:#17324d;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.04em;">Username</label>
        <input id="loginUser" type="text" placeholder="Enter username" required
               style="width:100%;padding:12px 14px;border:1.5px solid #d1d9dd;border-radius:8px;font-size:0.95rem;font-family:inherit;box-sizing:border-box;outline:none;transition:border 0.2s;"
               onfocus="this.style.borderColor='#17324d'" onblur="this.style.borderColor='#d1d9dd'">
      </div>
      <div style="text-align:left;margin-bottom:8px;">
        <label for="loginPass" style="display:block;font-size:0.8rem;font-weight:600;color:#17324d;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.04em;">Password</label>
        <input id="loginPass" type="password" placeholder="Enter password" required
               style="width:100%;padding:12px 14px;border:1.5px solid #d1d9dd;border-radius:8px;font-size:0.95rem;font-family:inherit;box-sizing:border-box;outline:none;transition:border 0.2s;"
               onfocus="this.style.borderColor='#17324d'" onblur="this.style.borderColor='#d1d9dd'">
      </div>
      <p id="loginError" style="color:#c0392b;font-size:0.82rem;min-height:20px;margin:4px 0 16px;" aria-live="polite"></p>
      <button type="submit"
              style="width:100%;padding:13px;background:linear-gradient(135deg,#17324d,#2e5c8a);color:#fff;border:none;border-radius:8px;font-size:1rem;font-weight:700;cursor:pointer;font-family:'Manrope',sans-serif;transition:opacity 0.2s;"
              onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
        Sign In
      </button>
    </form>
    <p style="color:#8a9ca5;font-size:0.75rem;margin-top:20px;">Demo credentials: <strong>clinician</strong> / <strong>clinic@123</strong></p>
  </div>
</div>

<script>
  // ── Auth Gate Logic ──
  const PORTAL_KEY = 'nexcura_clinician_auth';
  const VALID_USER = 'clinician';
  const VALID_PASS = 'clinic@123';

  function handleLogin(e) {
    e.preventDefault();
    const user = document.getElementById('loginUser').value.trim();
    const pass = document.getElementById('loginPass').value;
    if (user === VALID_USER && pass === VALID_PASS) {
      sessionStorage.setItem(PORTAL_KEY, 'authenticated');
      document.getElementById('loginGate').style.display = 'none';
      document.getElementById('portalContent').style.display = '';
    } else {
      document.getElementById('loginError').textContent = '✕ Invalid username or password. Please try again.';
      document.getElementById('loginPass').value = '';
      document.getElementById('loginPass').focus();
    }
    return false;
  }

  function signOut() {
    sessionStorage.removeItem(PORTAL_KEY);
    document.getElementById('portalContent').style.display = 'none';
    document.getElementById('loginGate').style.display = 'flex';
    document.getElementById('loginUser').value = '';
    document.getElementById('loginPass').value = '';
    document.getElementById('loginError').textContent = '';
  }

  // Auto-login if session exists
  if (sessionStorage.getItem(PORTAL_KEY) === 'authenticated') {
    document.getElementById('loginGate').style.display = 'none';
  }
</script>

<!-- ─── PORTAL CONTENT (hidden until authenticated) ──────────── -->
<div id="portalContent" style="display:none;">

<!-- ════════════════════════════════════════════════════════
     DEMO BANNER
═════════════════════════════════════════════════════════ -->
<div class="demo-banner" role="banner" aria-label="Important workspace preview notice">
  ⚠ WORKSPACE PREVIEW — Sample interface content only.
  <span>Not connected to EHR, patient records, or clinical systems. Production access must be enforced by a secure backend.</span>
</div>

<!-- ════════════════════════════════════════════════════════
     APP SHELL
═════════════════════════════════════════════════════════ -->
<div class="app-shell">

  <!-- ── SIDEBAR ─────────────────────────────────────────────── -->
  <aside class="sidebar" id="sidebar" role="navigation" aria-label="Clinical workspace navigation">
    <!-- Brand -->
    <div class="sidebar-brand">
      <div class="brand-mark-sm" aria-hidden="true"></div>
      <span class="sidebar-brand-name">Nex<em>Cura</em></span>
    </div>

    <!-- Clinician Card -->
    <div class="clinician-card" aria-label="Signed-in clinician">
      <div class="clinician-avatar" aria-hidden="true">AM</div>
      <div class="clinician-info">
        <small>ATTENDING</small>
        <strong>Dr. A. Mehta, MD</strong>
        <span>Internal Medicine</span>
      </div>
    </div>

    <!-- Nav -->
    <nav class="sidebar-nav" aria-label="Main sections">
      <div class="nav-section-label">Workspace</div>

      <button class="nav-item active" data-section="dashboard"
              aria-current="page" onclick="switchSection('dashboard', this)">
        <span class="nav-icon" aria-hidden="true">🏠</span>Dashboard
      </button>

      <button class="nav-item" data-section="patients"
              onclick="switchSection('patients', this)">
        <span class="nav-icon" aria-hidden="true">👥</span>Patient List
        <span class="nav-badge amber">6</span>
      </button>

      <button class="nav-item" data-section="encounter"
              onclick="switchSection('encounter', this)">
        <span class="nav-icon" aria-hidden="true">📝</span>Encounter Workspace
      </button>

      <div class="nav-section-label">Discovery</div>

      <button class="nav-item" data-section="trials"
              onclick="switchSection('trials', this)">
        <span class="nav-icon" aria-hidden="true">🔬</span>Trial Discovery
        <span class="nav-badge">1</span>
      </button>

      <div class="nav-section-label">Management</div>

      <button class="nav-item" data-section="referrals"
              onclick="switchSection('referrals', this)">
        <span class="nav-icon" aria-hidden="true">📤</span>Referrals
      </button>

      <button class="nav-item" data-section="tasks"
              onclick="switchSection('tasks', this)">
        <span class="nav-icon" aria-hidden="true">✅</span>Follow-Up Tasks
        <span class="nav-badge">3</span>
      </button>
    </nav>

    <!-- Sidebar Footer -->
    <div class="sidebar-footer">
      <div>NexCura v2.5 — Demo</div>
      <div style="margin-top:4px"><a href="index.html">← Back to home</a> · <a href="pages.html?page=contact-and-support">Support</a></div>
    </div>
  </aside>

  <!-- ── MAIN AREA ────────────────────────────────────────────── -->
  <div class="main-area">

    <!-- Top Bar -->
    <header class="topbar" role="banner">
      <button class="menu-toggle-btn" id="menuToggle" aria-label="Toggle navigation menu"
              aria-expanded="false" aria-controls="sidebar"
              onclick="toggleMobileSidebar()">☰</button>
      <div class="topbar-title">
        Clinical Workspace — Dr. A. Mehta, MD
        <small id="active-section-label">Dashboard — Today's Overview</small>
      </div>
      <div class="topbar-actions">
        <button class="topbar-btn" onclick="
      switchSection('encounter', document.querySelector('[data-section=encounter]'));
      if(window.activePatientId && PATIENTS[window.activePatientId]) {
         document.getElementById('soap-s').value = 'Patient ' + PATIENTS[window.activePatientId].initials + ' presents for...';
      }
    " aria-label="New encounter">+ New Encounter</button>
        
<div style="position:relative; display:inline-block;">
  <button class="topbar-btn" aria-label="Notifications" onclick="document.getElementById('notif-dropdown').classList.toggle('show')">🔔 <span class="sr-only">Notifications</span></button>
  <div id="notif-dropdown" class="dropdown-panel" style="display:none; position:absolute; right:0; top:100%; width:300px; background:white; border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow-lg); z-index:100; margin-top:8px;">
    <div style="padding:12px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center;">
      <strong style="font-family:Manrope,sans-serif; color:var(--navy);">Notifications</strong>
      <button class="btn btn-ghost btn-sm" style="font-size:10px; padding:2px 6px;" onclick="document.getElementById('notif-dropdown').style.display='none'; showPreviewMsg(this, 'All marked as read');">Mark all read</button>
    </div>
    <div style="padding:12px; border-bottom:1px solid var(--line);">
      <div style="font-size:11px; color:var(--navy);"><strong>New Lab Result</strong></div>
      <div style="font-size:10px; color:var(--muted);">HbA1c for R.D. is 8.1% (Above target).</div>
    </div>
    <div style="padding:12px; border-bottom:1px solid var(--line);">
      <div style="font-size:11px; color:var(--navy);"><strong>Intake Pending</strong></div>
      <div style="font-size:10px; color:var(--muted);">P.K. submitted intake form. Review needed.</div>
    </div>
    <div style="padding:12px;">
      <div style="font-size:11px; color:var(--navy);"><strong>Trial Match Found</strong></div>
      <div style="font-size:10px; color:var(--muted);">NCT04832167 matches patient R.D.</div>
    </div>
  </div>
</div>

        
<div style="position:relative; display:inline-block;">
  <button class="topbar-btn" aria-label="Settings" onclick="document.getElementById('settings-dropdown').classList.toggle('show')">⚙ <span class="sr-only">Settings</span></button>
  <div id="settings-dropdown" class="dropdown-panel" style="display:none; position:absolute; right:0; top:100%; width:250px; background:white; border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow-lg); z-index:100; margin-top:8px;">
    <div style="padding:12px; border-bottom:1px solid var(--line);">
      <strong style="font-family:Manrope,sans-serif; color:var(--navy);">Workspace Preferences</strong>
    </div>
    <div style="padding:12px; display:flex; flex-direction:column; gap:10px;">
      <label style="font-size:11px; display:flex; justify-content:space-between; align-items:center;">
        Theme: 
        <select style="font-size:10px; padding:2px 4px; border:1px solid var(--line); border-radius:4px;"><option>Light</option><option>Dark</option><option>System</option></select>
      </label>
      <label style="font-size:11px; display:flex; justify-content:space-between; align-items:center;">
        Notifications:
        <input type="checkbox" checked>
      </label>
      <label style="font-size:11px; display:flex; justify-content:space-between; align-items:center;">
        Default View:
        <select style="font-size:10px; padding:2px 4px; border:1px solid var(--line); border-radius:4px;"><option>Dashboard</option><option>Patient List</option></select>
      </label>
    </div>
  </div>
</div>

      </div>
    </header>

    <!-- ════════════════════════════════════════════════════════
         PAGE CONTENT
    ═════════════════════════════════════════════════════════ -->
    <main class="page-content" id="pageContent" role="main">

      <!-- ══════════════════════════════════════════════════
           SECTION 1 — DASHBOARD
      ═══════════════════════════════════════════════════ -->
      <section class="section-view active" id="section-dashboard" aria-labelledby="dash-heading">

        <div class="section-head">
          <span class="section-kicker">Today · Wed 24 Sep 2026</span>
          <h2 id="dash-heading">Good morning, Dr. Mehta 👋</h2>
          <p>Here's your clinical overview for today. <em class="sample-tag">Illustrative sample only</em></p>
        </div>

        <!-- Metric Strip -->
        <div class="metric-strip" role="list" aria-label="Today's metrics">
          <div class="metric-card" role="listitem">
            <div class="metric-icon icon-teal" aria-hidden="true">📅</div>
            <div class="metric-value">5</div>
            <div class="metric-label">Appointments Today</div>
            <div class="metric-tag"><span class="badge badge-green">2 Confirmed</span></div>
          </div>
          <div class="metric-card" role="listitem">
            <div class="metric-icon icon-amber" aria-hidden="true">📋</div>
            <div class="metric-value">2</div>
            <div class="metric-label">Pending Intake Reviews</div>
            <div class="metric-tag"><span class="badge badge-amber">Action needed</span></div>
          </div>
          <div class="metric-card" role="listitem">
            <div class="metric-icon icon-navy" aria-hidden="true">🔁</div>
            <div class="metric-value">3</div>
            <div class="metric-label">Follow-Up Tasks Due</div>
            <div class="metric-tag"><span class="badge badge-slate">1 Overdue</span></div>
          </div>
          <div class="metric-card" role="listitem">
            <div class="metric-icon icon-red" aria-hidden="true">🔬</div>
            <div class="metric-value">1</div>
            <div class="metric-label">Trial Match Alert</div>
            <div class="metric-tag"><span class="badge badge-red">Review now</span></div>
          </div>
        </div>

        <!-- Alerts -->
        <div style="margin-bottom:22px">
          <div class="alert-card" role="alert" aria-label="Trial match alert">
            <div class="alert-icon" aria-hidden="true">🔬</div>
            <div class="alert-body">
              <strong>Trial Match: Patient R.D. — NCT04832167</strong>
              <p>Preliminary eligibility criteria met for Phase II Glycaemic Control Study. Study team must confirm. <em class="sample-tag">Illustrative sample</em></p>
            </div>
            <button class="btn btn-sm btn-secondary" onclick="switchSection('trials', document.querySelector('[data-section=trials]'))">Review →</button>
          </div>
          <div class="alert-card amber" role="status" aria-label="Pending intake review">
            <div class="alert-icon" aria-hidden="true">📋</div>
            <div class="alert-body">
              <strong>2 Pending Intake Reviews</strong>
              <p>Patient P.K. and Patient S.T. submitted pre-visit intake forms that require clinician review before their appointments today.</p>
            </div>
            <button class="btn btn-sm btn-ghost" onclick="switchSection('patients', document.querySelector('[data-section=patients]'))">View Patients →</button>
          </div>
        </div>

        <div class="grid-2">
          <!-- Today's Schedule -->
          <div class="card">
            <div class="card-head">
              <h3>📅 Today's Schedule</h3>
              <span class="badge badge-teal">5 appointments</span>
            </div>
            <div class="card-body">
              <div class="schedule-list" role="list" aria-label="Today's appointments">
                <div class="schedule-item" role="listitem">
                  <div class="schedule-time">09:00</div>
                  <div class="schedule-sep" aria-hidden="true"></div>
                  <div class="schedule-info">
                    <strong>R.D. — Annual Review</strong>
                    <span>Internal Medicine · 45 min</span>
                  </div>
                  <span class="badge badge-green">Confirmed</span>
                </div>
                <div class="schedule-item" role="listitem">
                  <div class="schedule-time">10:00</div>
                  <div class="schedule-sep" aria-hidden="true"></div>
                  <div class="schedule-info">
                    <strong>P.K. — Intake Review</strong>
                    <span>New Patient · 60 min</span>
                  </div>
                  <span class="badge badge-amber">Intake Pending</span>
                </div>
                <div class="schedule-item" role="listitem">
                  <div class="schedule-time">11:30</div>
                  <div class="schedule-sep" aria-hidden="true"></div>
                  <div class="schedule-info">
                    <strong>S.T. — Telehealth Follow-up</strong>
                    <span>Telehealth · 30 min</span>
                  </div>
                  <span class="badge badge-teal">Telehealth</span>
                </div>
                <div class="schedule-item" role="listitem">
                  <div class="schedule-time">14:00</div>
                  <div class="schedule-sep" aria-hidden="true"></div>
                  <div class="schedule-info">
                    <strong>M.L. — Medication Review</strong>
                    <span>Pharmacology · 30 min</span>
                  </div>
                  <span class="badge badge-green">Confirmed</span>
                </div>
                <div class="schedule-item" role="listitem">
                  <div class="schedule-time">15:30</div>
                  <div class="schedule-sep" aria-hidden="true"></div>
                  <div class="schedule-info">
                    <strong>A.B. — Post-Op Check</strong>
                    <span>Follow-up · 20 min</span>
                  </div>
                  <span class="badge badge-slate">Pending Confirm</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div>
            <div class="card" style="margin-bottom:16px;">
              <div class="card-head"><h3>⚡ Quick Actions</h3></div>
              <div class="card-body">
                <div class="quick-actions" role="list">
                  <button class="qa-card" role="listitem"
                          onclick="switchSection('patients', document.querySelector('[data-section=patients]'))"
                          aria-label="Go to patient list">
                    <span class="qa-icon" aria-hidden="true">👥</span>
                    <strong>Patient List</strong>
                    <p>View all today's patients</p>
                  </button>
                  <button class="qa-card" role="listitem"
                          onclick="switchSection('encounter', document.querySelector('[data-section=encounter]'))"
                          aria-label="Open SOAP note editor">
                    <span class="qa-icon" aria-hidden="true">📝</span>
                    <strong>New SOAP Note</strong>
                    <p>Open encounter editor</p>
                  </button>
                  <button class="qa-card" role="listitem"
                          onclick="switchSection('trials', document.querySelector('[data-section=trials]'))"
                          aria-label="Go to trial discovery">
                    <span class="qa-icon" aria-hidden="true">🔬</span>
                    <strong>Trial Discovery</strong>
                    <p>Search ClinicalTrials</p>
