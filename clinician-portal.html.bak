                  <button class="qa-card" role="listitem"
                          onclick="switchSection('referrals', document.querySelector('[data-section=referrals]'))"
                          aria-label="View referrals">
                    <span class="qa-icon" aria-hidden="true">📤</span>
                    <strong>Referrals</strong>
                    <p>Track outgoing referrals</p>
                  </button>
                  <button class="qa-card" role="listitem"
                          onclick="switchSection('tasks', document.querySelector('[data-section=tasks]'))"
                          aria-label="View follow-up tasks">
                    <span class="qa-icon" aria-hidden="true">✅</span>
                    <strong>Follow-Up Tasks</strong>
