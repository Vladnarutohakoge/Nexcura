              <div class="msg-bubble sent" role="article" aria-label="Message sent by you, 13 September 2026">
                <div class="msg-bubble-inner">
                  Thank you! I wanted to ask — should I stop taking my Metformin the night before the appointment, or continue as usual? Also, do I need to fast before any blood work?
                </div>
                <div class="msg-time">13 Sep 2026, 11:24 AM</div>
              </div>

              <!-- Message 3 - received -->
              <div class="msg-bubble received" role="article" aria-label="Message from care team, 13 September 2026">
                <div class="msg-sender-name">Care Team — Dr. Sharma's Practice</div>
                <div class="msg-bubble-inner">
                  Great questions, Alex. Please continue your Metformin as prescribed — do not stop it without Dr. Sharma's guidance. Regarding fasting: yes, please fast for at least 8 hours before your appointment if blood work is planned. Water and your morning medications are fine. We'll confirm the full instructions in your pre-visit reminder closer to the date.
                </div>
                <div class="msg-time">13 Sep 2026, 2:45 PM</div>
              </div>

              <div class="msg-bubble received" role="article" aria-label="Latest message from care team, 23 September 2026">
                <div class="msg-sender-name">Care Team — Dr. Sharma's Practice</div>
                <div class="msg-bubble-inner">
                  Hi Alex! Your Blood Panel results have been reviewed by Dr. Sharma and are now available in the Test Results section of your portal. Please review them and bring any questions to your appointment on 28 Sep. See you soon! 😊
                </div>
                <div class="msg-time">23 Sep 2026, 9:15 AM · <strong>Unread</strong></div>
              </div>

            </div>

            <!-- Compose -->
            <div class="msg-compose" role="region" aria-label="Compose new message">
              <div class="msg-compose-disclaimer">
                <strong>ℹ Illustrative demo:</strong> This is a sample UI. No messages are transmitted or stored. For urgent medical concerns, contact your provider directly or call emergency services.
              </div>
              <div class="msg-input-row">
                <label for="msgInput" class="sr-only">Type your message</label>
                <textarea
                  id="msgInput"
                  placeholder="Type a message to your care team…"
                  aria-label="Compose message"
                ></textarea>
                <button class="btn btn-primary" style="align-self:flex-end;" onclick="sendDemoMessage()" aria-label="Send message (demo only)">
                  Send
                </button>
              </div>
            </div>

          </div>

        </div>

      </section>

      <!-- ══════════════════════════════
           SECTION 8: DOCUMENTS
      ══════════════════════════════ -->
      <section class="section" id="sec-documents" aria-labelledby="docs-title">

        <div class="section-header flex-between">
          <div>
            <h1 class="section-title" id="docs-title">Documents</h1>
            <p class="section-subtitle">Your health documents and reports — <em class="sample-tag">Illustrative sample only</em></p>
          </div>
          <button class="btn btn-primary" aria-label="Upload a new document">Upload Document</button>
        </div>

        <div class="grid-4" role="list" aria-label="Health documents">

          <!-- Doc 1 — PDF -->
          <article class="doc-card" role="listitem" aria-label="Discharge summary PDF document">
            <div style="display:flex; align-items:center; gap:12px;">
              <div class="doc-icon-wrap doc-icon-pdf" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 20 20" fill="#B42318">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <div class="doc-type">PDF</div>
                <div class="doc-name">Discharge_Summary_Aug2026.pdf</div>
              </div>
            </div>
            <div class="doc-meta">📅 Added: 08 Aug 2026</div>
            <div class="doc-meta">Source: Heartcare Specialists · <span class="sample-tag">Illustrative sample</span></div>
            <div class="doc-footer">
              <span style="font-size:.75rem;color:var(--success-green); font-weight:600;">● Verified</span>
              <button class="btn btn-secondary btn-sm" aria-label="Download Discharge Summary PDF (illustrative)">Download</button>
            </div>
          </article>

          <!-- Doc 2 — Image -->
          <article class="doc-card" role="listitem" aria-label="Chest X-Ray image document">
            <div style="display:flex; align-items:center; gap:12px;">
              <div class="doc-icon-wrap doc-icon-img" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 20 20" fill="var(--teal)">
                  <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <div class="doc-type">DICOM / Image</div>
                <div class="doc-name">ChestXRay_PA_02Aug2026.dcm</div>
              </div>
            </div>
            <div class="doc-meta">📅 Added: 04 Aug 2026</div>
            <div class="doc-meta">Source: City Health Centre Radiology · <span class="sample-tag">Illustrative sample</span></div>
            <div class="doc-footer">
              <span style="font-size:.75rem;color:var(--success-green); font-weight:600;">● Verified</span>
              <button class="btn btn-secondary btn-sm" aria-label="Download Chest X-Ray image (illustrative)">Download</button>
            </div>
          </article>

          <!-- Doc 3 — PDF -->
          <article class="doc-card" role="listitem" aria-label="Blood panel lab report PDF document">
            <div style="display:flex; align-items:center; gap:12px;">
              <div class="doc-icon-wrap doc-icon-pdf" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 20 20" fill="#B42318">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <div class="doc-type">PDF</div>
                <div class="doc-name">BloodPanel_FullReport_14Aug26.pdf</div>
              </div>
            </div>
            <div class="doc-meta">📅 Added: 15 Aug 2026</div>
            <div class="doc-meta">Source: City Health Centre Lab · <span class="sample-tag">Illustrative sample</span></div>
            <div class="doc-footer">
              <span style="font-size:.75rem;color:var(--success-green); font-weight:600;">● Verified</span>
              <button class="btn btn-secondary btn-sm" aria-label="Download Blood Panel report PDF (illustrative)">Download</button>
            </div>
          </article>

          <!-- Doc 4 — Spreadsheet / CSV -->
          <article class="doc-card" role="listitem" aria-label="HbA1c monitoring log document">
            <div style="display:flex; align-items:center; gap:12px;">
              <div class="doc-icon-wrap doc-icon-xls" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 20 20" fill="var(--success-green)">
                  <path fill-rule="evenodd" d="M5 4a3 3 0 00-3 3v6a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H5zm-1 9v-1h5v2H5a1 1 0 01-1-1zm7 1h4a1 1 0 001-1v-1h-5v2zm0-4h5V8h-5v2zM9 8H4v2h5V8z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <div class="doc-type">CSV / Data</div>
                <div class="doc-name">HbA1c_MonitoringLog_2026.csv</div>
              </div>
            </div>
            <div class="doc-meta">📅 Added: 21 Jul 2026</div>
            <div class="doc-meta">Source: Lakeside Medical Clinic · <span class="sample-tag">Illustrative sample</span></div>
            <div class="doc-footer">
              <span style="font-size:.75rem;color:var(--amber-dark); font-weight:600;">● Pending review</span>
              <button class="btn btn-secondary btn-sm" aria-label="Download HbA1c monitoring log (illustrative)">Download</button>
            </div>
          </article>

        </div>

        <p class="text-muted" style="margin-top:16px; font-size:.78rem; font-style:italic;">
          All documents listed are illustrative samples. No real files are stored or downloadable. Uploads are disabled in this demonstration.
        </p>

      </section>

    </div><!-- /main-content -->

  </div><!-- /portal-shell -->

  <!-- Screen reader only utility class -->
  <style>.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border-width:0; }</style>

  <script>
    // ═══════════════════════════════════════════════
    // LIVE DATE
    // ═══════════════════════════════════════════════
    (function updateDate() {
      const el = document.getElementById('liveDate');
      if (!el) return;
      const now = new Date();
      const opts = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
      el.textContent = now.toLocaleDateString('en-GB', opts);
    })();

    // ═══════════════════════════════════════════════
    // SECTION SWITCHING
    // ═══════════════════════════════════════════════
    const SECTIONS = ['dashboard','appointments','intake','history','medications','results','messages','documents'];

    function switchSection(id) {
      // Deactivate all sections
      SECTIONS.forEach(s => {
        const sec = document.getElementById('sec-' + s);
        if (sec) { sec.classList.remove('active'); sec.hidden = false; }
      });

      // Activate target
      const target = document.getElementById('sec-' + id);
      if (target) {
        SECTIONS.forEach(s => {
          const sec = document.getElementById('sec-' + s);
          if (sec) sec.classList.remove('active');
        });
        target.classList.add('active');
      }

      // Update sidebar nav items
      document.querySelectorAll('.nav-item').forEach(btn => {
        const isActive = btn.dataset.section === id;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-current', isActive ? 'page' : 'false');
      });

      // Update mobile tabs
      document.querySelectorAll('.mobile-tab').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.section === id);
      });

      // Scroll to top of main content on mobile
      if (window.innerWidth < 768) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        closeSidebar();
      }
    }

    // Attach nav item listeners
    document.querySelectorAll('.nav-item[data-section]').forEach(btn => {
      btn.addEventListener('click', () => switchSection(btn.dataset.section));
    });

    // Attach mobile tab listeners
    document.querySelectorAll('.mobile-tab[data-section]').forEach(btn => {
      btn.addEventListener('click', () => switchSection(btn.dataset.section));
    });

    // ═══════════════════════════════════════════════
    // MOBILE SIDEBAR TOGGLE
    // ═══════════════════════════════════════════════
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('show');
      overlay.setAttribute('aria-hidden', 'false');
      mobileMenuBtn.setAttribute('aria-expanded', 'true');
    }

    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('show');
      overlay.setAttribute('aria-hidden', 'true');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
    }

    mobileMenuBtn.addEventListener('click', () => {
      if (sidebar.classList.contains('open')) closeSidebar();
      else openSidebar();
    });

    overlay.addEventListener('click', closeSidebar);

    // Close sidebar on Escape
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && sidebar.classList.contains('open')) closeSidebar();
    });

    // ═══════════════════════════════════════════════
    // INTAKE FORM
    // ═══════════════════════════════════════════════

    // Show/hide "other symptoms" text field
    document.getElementById('symptomOther').addEventListener('change', function() {
      const group = document.getElementById('otherSymptomGroup');
      group.style.display = this.checked ? 'block' : 'none';
    });

    // Form submission
    document.getElementById('intakeForm').addEventListener('submit', function(e) {
      e.preventDefault();

      const reason = document.getElementById('reasonVisit').value.trim();
      const duration = document.getElementById('symptomDuration').value;

      if (!reason) {
        const el = document.getElementById('reasonVisit');
        el.focus();
        el.style.borderColor = 'var(--alert-red)';
        el.setAttribute('aria-invalid', 'true');
        return;
      }

      if (!duration) {
        const el = document.getElementById('symptomDuration');
        el.focus();
        el.style.borderColor = 'var(--alert-red)';
        return;
      }

      // Show success toast
      const toast = document.getElementById('intakeToast');
      toast.classList.add('show');
      toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      // Auto-hide after 6 seconds
      setTimeout(() => toast.classList.remove('show'), 6000);
    });

    // Clear error styles on input
    document.getElementById('reasonVisit').addEventListener('input', function() {
      this.style.borderColor = '';
      this.removeAttribute('aria-invalid');
    });

    // ═══════════════════════════════════════════════
    // DEMO MESSAGE SEND
    // ═══════════════════════════════════════════════
    function sendDemoMessage() {
      const input = document.getElementById('msgInput');
      const text = input.value.trim();
      if (!text) return;

      const msgBody = document.getElementById('msgBody');

      // Create sent bubble
      const bubble = document.createElement('div');
      bubble.className = 'msg-bubble sent';
      bubble.setAttribute('role', 'article');
      bubble.setAttribute('aria-label', 'Message sent by you just now');
      bubble.innerHTML = `
        <div class="msg-bubble-inner">${escapeHtml(text)}</div>
        <div class="msg-time">Just now · <em>Demo only — not transmitted</em></div>
      `;
      msgBody.appendChild(bubble);
      msgBody.scrollTop = msgBody.scrollHeight;

      input.value = '';
      input.focus();

      // Simulated reply after 2s
      setTimeout(() => {
        const reply = document.createElement('div');
        reply.className = 'msg-bubble received';
        reply.setAttribute('role', 'article');
        reply.setAttribute('aria-label', 'Auto-reply from care team (illustrative)');
        reply.innerHTML = `
          <div class="msg-sender-name">Care Team — Dr. Sharma's Practice</div>
          <div class="msg-bubble-inner">
            Thank you for your message, Alex. This is an illustrative demo — in a live system, your care team would review and respond within 1 business day. For urgent concerns, please call the practice directly or contact emergency services.
          </div>
          <div class="msg-time">Now · <em>Auto-reply — illustrative sample only</em></div>
        `;
        msgBody.appendChild(reply);
        msgBody.scrollTop = msgBody.scrollHeight;
      }, 2000);
    }

    function escapeHtml(str) {
      return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // Allow Enter to send message (Shift+Enter for newline)
    document.getElementById('msgInput').addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendDemoMessage();
      }
    });

    // ═══════════════════════════════════════════════
    // INITIAL SECTION SHOW (from hash or default)
    // ═══════════════════════════════════════════════
    (function init() {
      const hash = window.location.hash.replace('#', '');
      if (hash && SECTIONS.includes(hash)) {
        switchSection(hash);
      } else {
        // Ensure dashboard is active initially (already set in HTML)
        document.querySelectorAll('.nav-item[data-section="dashboard"]').forEach(btn => {
          btn.classList.add('active');
          btn.setAttribute('aria-current', 'page');
        });
      }
    })();

  </script>


<!-- ═════════════════════════════════════════════════════════════
     REUSABLE PORTAL MODAL & TOAST SYSTEM
═════════════════════════════════════════════════════════════ -->
<div id="patientModalOverlay" style="display:none; position:fixed; inset:0; background:rgba(18,59,61,0.65); z-index:9999; backdrop-filter:blur(3px); align-items:center; justify-content:center; padding:20px;">
  <div id="patientModalBox" style="background:#fff; width:100%; max-width:580px; border-radius:14px; box-shadow:0 24px 60px rgba(0,0,0,0.25); overflow:hidden; display:flex; flex-direction:column; max-height:85vh; animation:modalPop 0.25s cubic-bezier(0.16,1,0.3,1);">
    <div style="background:var(--teal); color:#fff; padding:18px 24px; display:flex; justify-content:space-between; align-items:center;">
      <h3 id="patientModalTitle" style="margin:0; font-family:'Manrope',sans-serif; font-size:1.15rem; color:#fff; font-weight:700;"></h3>
      <button onclick="closePatientModal()" style="background:none; border:none; color:#fff; font-size:1.6rem; line-height:1; cursor:pointer; padding:0 4px;" aria-label="Close modal">&times;</button>
    </div>
    <div id="patientModalBody" style="padding:24px; overflow-y:auto; font-size:0.92rem; line-height:1.6; color:var(--ink);"></div>
    <div id="patientModalFooter" style="padding:14px 24px; background:#f8faf9; border-top:1px solid #e2ece9; display:flex; justify-content:flex-end; gap:10px;">
      <button class="btn btn-secondary btn-sm" onclick="closePatientModal()">Close</button>
    </div>
  </div>
</div>

<!-- Global Toast Notification -->
<div id="portalGlobalToast" style="display:none; position:fixed; bottom:24px; right:24px; background:var(--teal); color:#fff; padding:14px 22px; border-radius:10px; box-shadow:0 12px 36px rgba(11,93,94,0.35); z-index:10000; font-weight:600; font-size:0.9rem; align-items:center; gap:10px; border-left:4px solid #14b8a6; animation:slideToast 0.3s ease;">
  <span id="portalToastIcon">&#10003;</span>
  <span id="portalToastMsg">Action completed successfully.</span>
</div>

<style>
@keyframes modalPop { from { opacity:0; transform:scale(0.94); } to { opacity:1; transform:scale(1); } }
@keyframes slideToast { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
</style>

</div><!-- /portalContent -->

<script>
  // Show portal content if already authenticated
  if (sessionStorage.getItem('nexcura_patient_auth') === 'authenticated') {
    document.getElementById('portalContent').style.display = '';
  }
</script>
<script src="static/js/i18n.js"></script>
</body>
</html>
