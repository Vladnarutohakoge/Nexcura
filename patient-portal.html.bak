<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Patient Portal — NexCura</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    /* ════════════════════════════════════════════
       DESIGN TOKENS
    ════════════════════════════════════════════ */
    :root {
      --teal:          #0b5d5e;
      --teal-dark:     #084445;
      --teal-mid:      #0d7070;
      --teal-light:    #e6f4f1;
      --navy:          #17324d;
      --mint:          #dff1e9;
      --cream:         #fafaf6;
      --ink:           #183537;
      --muted:         #657779;
      --alert-red:     #B42318;
      --alert-red-bg:  #FEF3F2;
      --success-green: #247A52;
      --success-bg:    #ECFDF3;
      --amber:         #F2B95E;
      --amber-dark:    #92570e;
      --amber-bg:      #FFFAEB;
      --slate:         #4A5568;
      --slate-bg:      #EDF2F7;
      --border:        #d6e4e1;
      --white:         #ffffff;
      --sidebar-w:     220px;
      --header-h:      64px;
      --radius:        10px;
      --radius-lg:     16px;
      --shadow-sm:     0 1px 3px rgba(11,93,94,.10), 0 1px 2px rgba(11,93,94,.06);
      --shadow-md:     0 4px 12px rgba(11,93,94,.12), 0 2px 4px rgba(11,93,94,.06);
      --transition:    0.2s ease;
    }

    /* ════════════════════════════════════════════
       RESET & BASE
    ════════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--cream);
      color: var(--ink);
      line-height: 1.6;
      min-height: 100vh;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Manrope', sans-serif;
      color: var(--navy);
      line-height: 1.3;
    }

    a { color: var(--teal); text-decoration: none; }
    a:hover { text-decoration: underline; }

    :focus-visible {
      outline: 3px solid var(--amber);
      outline-offset: 2px;
      border-radius: 4px;
    }

    img { display: block; max-width: 100%; }

    /* ════════════════════════════════════════════
       DEMO BANNER
    ════════════════════════════════════════════ */
    .demo-banner {
      position: sticky;
      top: 0;
      z-index: 200;
      background: var(--amber);
      color: var(--amber-dark);
      text-align: center;
      padding: 8px 16px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-bottom: 2px solid #d4a54a;
    }

    .demo-banner span { font-weight: 400; text-transform: none; letter-spacing: 0; }

    /* ════════════════════════════════════════════
       LAYOUT SHELL
    ════════════════════════════════════════════ */
    .portal-shell {
      display: flex;
      min-height: calc(100vh - 36px); /* minus demo banner */
    }

    /* ════════════════════════════════════════════
       SIDEBAR
    ════════════════════════════════════════════ */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--teal);
      color: var(--white);
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 36px; /* demo banner height */
      left: 0;
      bottom: 0;
      overflow-y: auto;
      z-index: 100;
      transition: transform var(--transition);
    }

    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.2); border-radius: 2px; }

    /* Patient Avatar */
    .sidebar-profile {
      padding: 24px 16px 20px;
      border-bottom: 1px solid rgba(255,255,255,.15);
    }

    .avatar-circle {
      width: 52px;
      height: 52px;
      background: rgba(255,255,255,.2);
      border: 2px solid rgba(255,255,255,.4);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Manrope', sans-serif;
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--white);
      margin-bottom: 10px;
      flex-shrink: 0;
    }

    .sidebar-name {
      font-family: 'Manrope', sans-serif;
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--white);
      line-height: 1.2;
    }

    .sidebar-meta {
      font-size: 0.72rem;
      color: rgba(255,255,255,.65);
      margin-top: 2px;
    }

    /* Nav */
    .sidebar-nav {
      flex: 1;
      padding: 12px 0;
    }

    .nav-section-label {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,.45);
      padding: 12px 18px 4px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px;
      color: rgba(255,255,255,.82);
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
      border-radius: 0;
      transition: background var(--transition), color var(--transition);
      border-left: 3px solid transparent;
      font-family: 'DM Sans', sans-serif;
    }

    .nav-item:hover {
      background: rgba(255,255,255,.1);
      color: var(--white);
    }

    .nav-item.active {
      background: rgba(255,255,255,.15);
      color: var(--white);
      font-weight: 700;
      border-left-color: var(--amber);
    }

    .nav-icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      opacity: 0.85;
    }

    .nav-item.active .nav-icon { opacity: 1; }

    /* Sidebar Footer */
    .sidebar-footer {
      padding: 16px;
      border-top: 1px solid rgba(255,255,255,.15);
    }

    .emergency-notice {
      background: rgba(180,35,24,.25);
      border: 1px solid rgba(180,35,24,.5);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 0.72rem;
      color: #ffc4be;
      line-height: 1.4;
    }

    .emergency-notice strong {
      display: block;
      color: #ffb3ab;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 3px;
    }

    /* ════════════════════════════════════════════
       MAIN CONTENT
    ════════════════════════════════════════════ */
    .main-content {
      margin-left: var(--sidebar-w);
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }

    /* Top Bar */
    .portal-topbar {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 0 28px;
      height: var(--header-h);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      position: sticky;
      top: 36px;
      z-index: 50;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .portal-logo {
      font-family: 'Manrope', sans-serif;
      font-weight: 800;
      font-size: 1.25rem;
      color: var(--teal);
      letter-spacing: -0.02em;
    }

    .portal-logo span { color: var(--amber-dark); }

    .topbar-divider {
      width: 1px;
      height: 24px;
      background: var(--border);
    }

    .topbar-greeting {
      font-size: 0.875rem;
      color: var(--muted);
    }

    .topbar-greeting strong { color: var(--ink); }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .topbar-date {
      font-size: 0.8rem;
      color: var(--muted);
      white-space: nowrap;
    }

    .btn-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background var(--transition);
      position: relative;
    }

    .btn-icon:hover { background: var(--mint); }

    .notif-dot {
      position: absolute;
      top: 6px; right: 7px;
      width: 8px; height: 8px;
      background: var(--alert-red);
      border-radius: 50%;
      border: 2px solid var(--white);
    }

    /* Mobile menu toggle */
    .mobile-menu-btn {
      display: none;
      width: 40px; height: 40px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--white);
      cursor: pointer;
      align-items: center; justify-content: center;
      flex-direction: column;
      gap: 5px;
      padding: 10px;
    }

    .mobile-menu-btn span {
      display: block;
      width: 100%; height: 2px;
      background: var(--ink);
      border-radius: 2px;
      transition: transform var(--transition), opacity var(--transition);
    }

    /* ════════════════════════════════════════════
       SECTION CONTENT
    ════════════════════════════════════════════ */
    .section {
      display: none;
      padding: 28px 28px 48px;
      animation: fadeIn 0.25s ease;
    }

    .section.active { display: block; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .section-header {
      margin-bottom: 24px;
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 4px;
    }

    .section-subtitle {
      font-size: 0.875rem;
      color: var(--muted);
    }

    /* ════════════════════════════════════════════
       CARDS
    ════════════════════════════════════════════ */
    .card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }

    .card-title {
      font-family: 'Manrope', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 4px;
    }

    .card-meta {
      font-size: 0.8rem;
      color: var(--muted);
    }

    /* Grid layouts */
    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    /* ════════════════════════════════════════════
       BADGES
    ════════════════════════════════════════════ */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 100px;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .badge::before {
      content: '';
      width: 6px; height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .badge-confirmed {
      background: var(--success-bg);
      color: var(--success-green);
    }
    .badge-confirmed::before { background: var(--success-green); }

    .badge-pending {
      background: var(--amber-bg);
      color: var(--amber-dark);
    }
    .badge-pending::before { background: var(--amber); }

    .badge-completed {
      background: var(--slate-bg);
      color: var(--slate);
    }
    .badge-completed::before { background: var(--slate); }

    .badge-available {
      background: var(--teal-light);
      color: var(--teal-dark);
    }
    .badge-available::before { background: var(--teal); }

    .badge-patient-reported {
      background: var(--mint);
      color: var(--teal-dark);
      font-size: 0.68rem;
    }
    .badge-patient-reported::before { display: none; }

    /* ════════════════════════════════════════════
       BUTTONS
    ════════════════════════════════════════════ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 18px;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      border: none;
      transition: background var(--transition), box-shadow var(--transition), transform 0.1s;
      text-decoration: none;
      white-space: nowrap;
    }

    .btn:active { transform: scale(0.98); }

    .btn-primary {
      background: var(--teal);
      color: var(--white);
    }
    .btn-primary:hover { background: var(--teal-dark); box-shadow: var(--shadow-sm); }

    .btn-secondary {
      background: var(--mint);
      color: var(--teal);
      border: 1px solid var(--border);
    }
    .btn-secondary:hover { background: var(--teal-light); }

    .btn-ghost {
      background: transparent;
      color: var(--teal);
      border: 1px solid var(--teal);
    }
    .btn-ghost:hover { background: var(--teal-light); }

    .btn-danger-ghost {
      background: transparent;
      color: var(--alert-red);
      border: 1px solid var(--alert-red);
      font-size: 0.8rem;
      padding: 6px 14px;
    }
    .btn-danger-ghost:hover { background: var(--alert-red-bg); }

    .btn-sm {
      font-size: 0.8rem;
      padding: 6px 14px;
    }

    /* ════════════════════════════════════════════
       SECTION 1: DASHBOARD
    ════════════════════════════════════════════ */
    .welcome-banner {
      background: linear-gradient(135deg, var(--teal) 0%, var(--teal-mid) 60%, #1a8a8b 100%);
      border-radius: var(--radius-lg);
      padding: 28px 32px;
      color: var(--white);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
    }

    .welcome-banner::after {
      content: '';
      position: absolute;
      right: -40px; top: -40px;
      width: 200px; height: 200px;
      border-radius: 50%;
      background: rgba(255,255,255,.06);
    }

    .welcome-banner::before {
      content: '';
      position: absolute;
      right: 60px; bottom: -60px;
      width: 160px; height: 160px;
      border-radius: 50%;
      background: rgba(255,255,255,.04);
    }

    .welcome-text h2 {
      color: var(--white);
      font-size: 1.6rem;
      font-weight: 800;
      margin-bottom: 6px;
    }

    .welcome-text p {
      color: rgba(255,255,255,.78);
      font-size: 0.9rem;
    }

    .welcome-badge {
      background: rgba(255,255,255,.15);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255,255,255,.25);
      border-radius: 12px;
      padding: 14px 20px;
      text-align: center;
      flex-shrink: 0;
      z-index: 1;
    }

    .welcome-badge .label {
      font-size: 0.7rem;
      color: rgba(255,255,255,.7);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
    }

    .welcome-badge .value {
      font-family: 'Manrope', sans-serif;
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--white);
      line-height: 1.1;
      margin: 2px 0;
    }

    .welcome-badge .sub {
      font-size: 0.72rem;
      color: rgba(255,255,255,.65);
    }

    /* Upcoming Appointment Card */
    .appt-highlight {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px 24px;
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 24px;
      box-shadow: var(--shadow-sm);
    }

    .appt-date-block {
      background: var(--mint);
      border-radius: 10px;
      padding: 10px 14px;
      text-align: center;
      flex-shrink: 0;
      min-width: 60px;
    }

    .appt-day { font-size: 1.6rem; font-weight: 800; color: var(--teal); font-family: 'Manrope', sans-serif; line-height: 1; }
    .appt-month { font-size: 0.7rem; font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: 0.06em; }

    .appt-details { flex: 1; min-width: 0; }
    .appt-details h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    .appt-details .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 16px;
      font-size: 0.8rem;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .meta-item { display: flex; align-items: center; gap: 4px; }

    .appt-actions { display: flex; gap: 8px; flex-shrink: 0; }

    /* Action Cards */
    .action-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      cursor: pointer;
      transition: box-shadow var(--transition), border-color var(--transition), transform 0.15s;
      box-shadow: var(--shadow-sm);
    }

    .action-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--teal);
      transform: translateY(-2px);
    }

    .action-icon {
      width: 44px; height: 44px;
      border-radius: 10px;
      background: var(--teal-light);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .action-icon svg { color: var(--teal); }

    .action-card h3 { font-size: 0.95rem; font-weight: 700; color: var(--navy); margin: 0; }
    .action-card p { font-size: 0.8rem; color: var(--muted); margin: 0; }

    /* Notifications */
    .notifications-panel { margin-top: 24px; }
    .panel-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 12px;
    }
    .panel-header h2 { font-size: 1rem; font-weight: 700; color: var(--navy); }

    .notif-item {
      display: flex;
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
    }
    .notif-item:last-child { border-bottom: none; }

    .notif-dot-badge {
      width: 10px; height: 10px;
      border-radius: 50%;
      margin-top: 5px;
      flex-shrink: 0;
    }
    .notif-dot-badge.blue { background: var(--teal); }
    .notif-dot-badge.amber { background: var(--amber); }

    .notif-content h4 { font-size: 0.875rem; font-weight: 600; color: var(--ink); margin-bottom: 2px; }
    .notif-content p { font-size: 0.8rem; color: var(--muted); margin-bottom: 4px; }
    .notif-time { font-size: 0.72rem; color: var(--muted); }

    /* ════════════════════════════════════════════
       SECTION 2: APPOINTMENTS
    ════════════════════════════════════════════ */
    .appt-list { display: flex; flex-direction: column; gap: 14px; }

    .appt-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 16px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition);
    }
    .appt-card:hover { box-shadow: var(--shadow-md); }

    .appt-card-date {
      background: var(--mint);
      border-radius: 8px;
      padding: 8px 12px;
      text-align: center;
      min-width: 54px;
      flex-shrink: 0;
    }
    .appt-card-date .d { font-size: 1.3rem; font-weight: 800; color: var(--teal); font-family: 'Manrope', sans-serif; line-height: 1; }
    .appt-card-date .m { font-size: 0.65rem; font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: 0.05em; }

    .appt-card-body { flex: 1; min-width: 0; }
    .appt-card-body h3 { font-size: 0.95rem; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    .appt-card-meta { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.78rem; color: var(--muted); margin-bottom: 8px; }
    .appt-card-actions { display: flex; gap: 8px; flex-shrink: 0; align-items: center; }

    /* ════════════════════════════════════════════
       SECTION 3: INTAKE FORM
    ════════════════════════════════════════════ */
    .intake-form-wrapper {
      max-width: 700px;
    }

    .form-disclaimer {
      background: var(--mint);
      border-left: 4px solid var(--teal);
      border-radius: 0 8px 8px 0;
      padding: 12px 16px;
      margin-bottom: 24px;
      font-size: 0.82rem;
      color: var(--teal-dark);
    }
    .form-disclaimer strong { font-weight: 700; }

    .form-group {
      margin-bottom: 20px;
    }

    label.field-label {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 6px;
    }

    label.field-label .required {
      color: var(--alert-red);
      margin-left: 3px;
    }

    .form-input,
    .form-textarea,
    .form-select {
      width: 100%;
      padding: 10px 14px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.875rem;
      color: var(--ink);
      background: var(--white);
      transition: border-color var(--transition), box-shadow var(--transition);
    }

    .form-input:focus,
    .form-textarea:focus,
    .form-select:focus {
      outline: none;
      border-color: var(--teal);
      box-shadow: 0 0 0 3px rgba(11,93,94,.12);
    }

    .form-textarea { resize: vertical; min-height: 90px; }

    .checkbox-group {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 4px;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.875rem;
      color: var(--ink);
      cursor: pointer;
    }

    .checkbox-label input[type="checkbox"] {
      width: 17px;
      height: 17px;
      accent-color: var(--teal);
      cursor: pointer;
    }

    .form-hint {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 4px;
    }

    .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 8px;
      flex-wrap: wrap;
    }

    .form-section-divider {
      border: none;
      border-top: 1px solid var(--border);
      margin: 28px 0;
    }

    .form-section-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 16px;
    }

    /* Success toast */
    .toast {
      display: none;
      align-items: center;
      gap: 10px;
      padding: 12px 18px;
      background: var(--success-bg);
      border: 1px solid var(--success-green);
      border-radius: 8px;
      color: var(--success-green);
      font-size: 0.875rem;
      font-weight: 600;
      margin-top: 16px;
    }
    .toast.show { display: flex; }

    /* ════════════════════════════════════════════
       SECTION 4: MEDICAL HISTORY
    ════════════════════════════════════════════ */
    .table-wrapper {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }

    thead tr {
      background: var(--mint);
    }

    th {
      padding: 13px 16px;
      text-align: left;
      font-family: 'Manrope', sans-serif;
      font-weight: 700;
      font-size: 0.78rem;
      color: var(--teal);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid var(--border);
    }

    td {
      padding: 14px 16px;
      color: var(--ink);
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: rgba(11,93,94,.025); }

    .status-pill {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 10px;
      border-radius: 100px;
    }

    .status-ongoing { background: var(--success-bg); color: var(--success-green); }
    .status-resolved { background: var(--slate-bg); color: var(--slate); }

    /* History notes */
    .history-note {
      background: var(--amber-bg);
      border: 1px solid #f5d48a;
      border-radius: 8px;
      padding: 12px 16px;
      margin-top: 16px;
      font-size: 0.8rem;
      color: var(--amber-dark);
    }

    /* ════════════════════════════════════════════
       SECTION 5: MEDICATIONS
    ════════════════════════════════════════════ */
    .med-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px 22px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition);
    }
    .med-card:hover { box-shadow: var(--shadow-md); }

    .med-icon {
      width: 48px; height: 48px;
      background: var(--teal-light);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .med-body { flex: 1; min-width: 0; }
    .med-name { font-family: 'Manrope', sans-serif; font-size: 1.05rem; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    .med-dose { font-size: 0.875rem; color: var(--teal); font-weight: 600; margin-bottom: 8px; }
    .med-meta { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 0.8rem; color: var(--muted); }
    .med-meta-item { display: flex; align-items: center; gap: 5px; }

    .med-actions { flex-shrink: 0; }

    .meds-disclaimer {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 16px;
      padding: 10px 14px;
      background: var(--amber-bg);
      border-radius: 8px;
      border: 1px solid #f5d48a;
    }

    /* ════════════════════════════════════════════
       SECTION 6: TEST RESULTS
    ════════════════════════════════════════════ */
    .results-list { display: flex; flex-direction: column; gap: 14px; }

    .result-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 16px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition);
    }
    .result-card:hover { box-shadow: var(--shadow-md); }

    .result-icon {
      width: 48px; height: 48px;
      border-radius: 12px;
      background: var(--teal-light);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }

    .result-body { flex: 1; min-width: 0; }
    .result-name { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    .result-meta { font-size: 0.8rem; color: var(--muted); display: flex; gap: 16px; flex-wrap: wrap; }

    .result-actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }

    .results-disclaimer {
      margin-top: 16px;
      padding: 12px 16px;
      background: var(--mint);
      border-left: 4px solid var(--teal);
      border-radius: 0 8px 8px 0;
      font-size: 0.8rem;
      color: var(--teal-dark);
    }

    /* ════════════════════════════════════════════
       SECTION 7: MESSAGES
    ════════════════════════════════════════════ */
    .messages-layout {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 16px;
      height: 580px;
    }

    .msg-threads {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .msg-threads-header {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      font-family: 'Manrope', sans-serif;
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--navy);
    }

    .thread-item {
      padding: 13px 16px;
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      transition: background var(--transition);
    }
    .thread-item:hover { background: var(--mint); }
    .thread-item.active { background: var(--teal-light); border-left: 3px solid var(--teal); }

    .thread-name { font-size: 0.83rem; font-weight: 700; color: var(--navy); }
    .thread-preview { font-size: 0.75rem; color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .thread-time { font-size: 0.7rem; color: var(--muted); float: right; }

    .msg-panel {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }

    .msg-panel-header {
      padding: 14px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .msg-avatar-sm {
      width: 36px; height: 36px;
      background: var(--mint);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--teal);
      font-family: 'Manrope', sans-serif;
      flex-shrink: 0;
    }

    .msg-panel-name { font-size: 0.9rem; font-weight: 700; color: var(--navy); }
    .msg-panel-sub { font-size: 0.75rem; color: var(--muted); }

    .msg-body {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .msg-body::-webkit-scrollbar { width: 4px; }
    .msg-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

    .msg-bubble {
      max-width: 70%;
    }

    .msg-bubble.sent {
      align-self: flex-end;
    }

    .msg-bubble-inner {
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 0.85rem;
      line-height: 1.5;
    }

    .msg-bubble.received .msg-bubble-inner {
      background: var(--mint);
      color: var(--ink);
      border-bottom-left-radius: 2px;
    }

    .msg-bubble.sent .msg-bubble-inner {
      background: var(--teal);
      color: var(--white);
      border-bottom-right-radius: 2px;
    }

    .msg-time {
      font-size: 0.68rem;
      color: var(--muted);
      margin-top: 4px;
    }
    .msg-bubble.sent .msg-time { text-align: right; }

    .msg-sender-name {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--teal);
      margin-bottom: 3px;
    }

    .msg-compose {
      padding: 14px 20px;
      border-top: 1px solid var(--border);
      background: var(--cream);
    }

    .msg-compose-disclaimer {
      font-size: 0.72rem;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .msg-input-row {
      display: flex;
      gap: 10px;
    }

    .msg-compose textarea {
      flex: 1;
      padding: 10px 14px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.85rem;
      resize: none;
      height: 60px;
      color: var(--ink);
    }

    .msg-compose textarea:focus {
      outline: none;
      border-color: var(--teal);
      box-shadow: 0 0 0 3px rgba(11,93,94,.12);
    }

    /* ════════════════════════════════════════════
       SECTION 8: DOCUMENTS
    ════════════════════════════════════════════ */
    .doc-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: var(--shadow-sm);
      transition: box-shadow var(--transition), transform 0.15s;
    }
    .doc-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }

    .doc-icon-wrap {
      width: 48px; height: 48px;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }

    .doc-icon-pdf { background: #FEF3F2; }
    .doc-icon-img { background: var(--mint); }
    .doc-icon-xls { background: #ECFDF3; }

    .doc-name { font-weight: 700; font-size: 0.9rem; color: var(--navy); word-break: break-word; }
    .doc-meta { font-size: 0.78rem; color: var(--muted); }
    .doc-type { font-size: 0.72rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }

    .doc-footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }

    /* ════════════════════════════════════════════
       MOBILE TAB BAR
    ════════════════════════════════════════════ */
    .mobile-tab-bar {
      display: none;
      overflow-x: auto;
      background: var(--teal);
      padding: 4px 8px;
      gap: 2px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .mobile-tab-bar::-webkit-scrollbar { display: none; }

    .mobile-tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      padding: 8px 12px;
      border-radius: 8px;
      border: none;
      background: none;
      color: rgba(255,255,255,.7);
      font-size: 0.65rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      white-space: nowrap;
      transition: background var(--transition), color var(--transition);
      flex-shrink: 0;
    }

    .mobile-tab:hover { background: rgba(255,255,255,.1); color: var(--white); }
    .mobile-tab.active { background: rgba(255,255,255,.18); color: var(--white); }

    /* ════════════════════════════════════════════
       SAMPLE DATA WATERMARK
    ════════════════════════════════════════════ */
    .sample-tag {
      font-size: 0.68rem;
      color: var(--muted);
      font-style: italic;
      opacity: 0.75;
    }

    /* ════════════════════════════════════════════
       UTILITY
    ════════════════════════════════════════════ */
    .mb-16 { margin-bottom: 16px; }
    .mb-24 { margin-bottom: 24px; }
    .flex { display: flex; }
    .flex-between { display: flex; justify-content: space-between; align-items: center; }
    .gap-8 { gap: 8px; }
    .gap-16 { gap: 16px; }
    .text-muted { color: var(--muted); font-size: 0.8rem; }
    .text-small { font-size: 0.78rem; }

    /* ════════════════════════════════════════════
       RESPONSIVE
    ════════════════════════════════════════════ */
    @media (max-width: 1100px) {
      .grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 900px) {
      .grid-3 { grid-template-columns: repeat(2, 1fr); }
      .messages-layout { grid-template-columns: 1fr; height: auto; }
      .msg-threads { height: 200px; overflow-y: auto; }
      .msg-panel { height: 480px; }
    }

    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
        top: 36px;
        z-index: 200;
      }
      .sidebar.open { transform: translateX(0); }

      .main-content {
        margin-left: 0;
      }

      .mobile-menu-btn { display: flex; }
      .mobile-tab-bar { display: flex; }

      .portal-topbar {
        padding: 0 16px;
        top: 36px;
      }

      .topbar-greeting { display: none; }
      .topbar-divider { display: none; }

      .section {
        padding: 16px 16px 40px;
      }

      .welcome-banner {
        flex-direction: column;
        align-items: flex-start;
        padding: 20px;
      }

      .welcome-badge { width: 100%; }

      .appt-highlight {
        flex-direction: column;
        align-items: flex-start;
      }

      .appt-actions { width: 100%; }

      .grid-2,
      .grid-3,
      .grid-4 { grid-template-columns: 1fr; }

      .appt-card { flex-wrap: wrap; }
      .appt-card-actions { width: 100%; }

      .med-card { flex-direction: column; }

      .result-card { flex-wrap: wrap; }
      .result-actions { width: 100%; }
    }

    @media (max-width: 480px) {
      .welcome-text h2 { font-size: 1.25rem; }
      .topbar-date { display: none; }
    }

    /* Overlay for mobile sidebar */
    .sidebar-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.4);
      z-index: 150;
    }
    .sidebar-overlay.show { display: block; }
  </style>
</head>

<body>

<!-- ─── LOGIN GATE ─────────────────────────────────────────────── -->
<div id="loginGate" style="display:flex;position:fixed;inset:0;z-index:9999;background:linear-gradient(135deg,#0a2526 0%,#0b5d5e 50%,#083839 100%);align-items:center;justify-content:center;font-family:'DM Sans','Manrope',sans-serif;">
  <div style="background:#fff;border-radius:18px;padding:48px 40px;max-width:420px;width:90%;box-shadow:0 24px 64px rgba(0,0,0,0.35);text-align:center;">
    <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#0b5d5e,#14a3a3);margin:0 auto 20px;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 20px rgba(11,93,94,0.3);">
      <span style="color:#fff;font-size:24px;font-weight:800;font-family:'Manrope',sans-serif;">NC</span>
    </div>
    <h1 style="font-family:'Manrope',sans-serif;font-size:1.5rem;color:#0a1e1e;margin:0 0 6px;">Patient Portal</h1>
    <p style="color:#5a6a72;font-size:0.9rem;margin:0 0 28px;">Enter your credentials to access your health records and appointments.</p>
    <form id="loginForm" onsubmit="return handleLogin(event)" autocomplete="off">
      <div style="text-align:left;margin-bottom:16px;">
        <label for="loginUser" style="display:block;font-size:0.8rem;font-weight:600;color:#17324d;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.04em;">Username</label>
        <input id="loginUser" type="text" placeholder="Enter username" required
               style="width:100%;padding:12px 14px;border:1.5px solid #d1d9dd;border-radius:8px;font-size:0.95rem;font-family:inherit;box-sizing:border-box;outline:none;transition:border 0.2s;"
               onfocus="this.style.borderColor='#0b5d5e'" onblur="this.style.borderColor='#d1d9dd'">
      </div>
      <div style="text-align:left;margin-bottom:8px;">
        <label for="loginPass" style="display:block;font-size:0.8rem;font-weight:600;color:#17324d;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.04em;">Password</label>
        <input id="loginPass" type="password" placeholder="Enter password" required
               style="width:100%;padding:12px 14px;border:1.5px solid #d1d9dd;border-radius:8px;font-size:0.95rem;font-family:inherit;box-sizing:border-box;outline:none;transition:border 0.2s;"
               onfocus="this.style.borderColor='#0b5d5e'" onblur="this.style.borderColor='#d1d9dd'">
      </div>
      <p id="loginError" style="color:#c0392b;font-size:0.82rem;min-height:20px;margin:4px 0 16px;" aria-live="polite"></p>
      <button type="submit"
              style="width:100%;padding:13px;background:linear-gradient(135deg,#0b5d5e,#14a3a3);color:#fff;border:none;border-radius:8px;font-size:1rem;font-weight:700;cursor:pointer;font-family:'Manrope',sans-serif;box-shadow:0 4px 14px rgba(11,93,94,0.3);transition:opacity 0.2s;"
              onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
        Sign In
      </button>
    </form>
    <p style="color:#8a9ca5;font-size:0.75rem;margin-top:20px;">Demo credentials: <strong>patient</strong> / <strong>patient@123</strong></p>
  </div>
</div>

<script>
  // ── Patient Auth Gate Logic ──
  const PATIENT_PORTAL_KEY = 'nexcura_patient_auth';
  const VALID_PATIENT_USER = 'patient';
  const VALID_PATIENT_PASS = 'patient@123';

  function handleLogin(e) {
    e.preventDefault();
    const user = document.getElementById('loginUser').value.trim();
    const pass = document.getElementById('loginPass').value;
    if (user === VALID_PATIENT_USER && pass === VALID_PATIENT_PASS) {
      sessionStorage.setItem(PATIENT_PORTAL_KEY, 'authenticated');
      document.getElementById('loginGate').style.display = 'none';
      document.getElementById('portalContent').style.display = '';
    } else {
      document.getElementById('loginError').textContent = '✕ Invalid username or password. Please try again.';
      document.getElementById('loginPass').value = '';
      document.getElementById('loginPass').focus();
    }
    return false;
  }

  function signOut() {
    sessionStorage.removeItem(PATIENT_PORTAL_KEY);
    document.getElementById('portalContent').style.display = 'none';
    document.getElementById('loginGate').style.display = 'flex';
    document.getElementById('loginUser').value = '';
    document.getElementById('loginPass').value = '';
    document.getElementById('loginError').textContent = '';
  }

  // Auto-login if session exists
  if (sessionStorage.getItem(PATIENT_PORTAL_KEY) === 'authenticated') {
    document.getElementById('loginGate').style.display = 'none';
  }
</script>

<!-- ─── PORTAL CONTENT (hidden until authenticated) ──────────── -->
<div id="portalContent" style="display:none;">

  <!-- ══ DEMO BANNER ══ -->
  <div class="demo-banner" role="status" aria-live="polite">
    ⚠ ILLUSTRATIVE SAMPLE ONLY —
    <span>No real patient data connected. All information shown is fictitious and for demonstration purposes only.</span>
  </div>

  <!-- ══ SIDEBAR OVERLAY (mobile) ══ -->
  <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

  <!-- ══ PORTAL SHELL ══ -->
  <div class="portal-shell">

    <!-- ════ SIDEBAR ════ -->
    <aside class="sidebar" id="sidebar" role="navigation" aria-label="Patient portal navigation">

      <!-- Profile -->
            <!-- Visible Back to Home Link -->
      <div style="padding: 14px 16px 4px;">
        <a href="index.html" class="back-home-link" style="display: flex; align-items: center; gap: 8px; color: #bbf7d0; background: rgba(255,255,255,0.12); padding: 8px 12px; border-radius: 8px; font-size: 0.82rem; font-weight: 700; text-decoration: none; border: 1px solid rgba(255,255,255,0.18); transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">
          <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
          Back to Home
        </a>
      </div>
      <div class="sidebar-profile">
        <div class="avatar-circle" aria-label="Patient initials: AM">AM</div>
        <div class="sidebar-name">Alex Morgan</div>
        <div class="sidebar-meta">Patient ID: NXC-2026-00147 &nbsp;·&nbsp; <span style="color:rgba(255,255,255,.5)">Illustrative sample only</span></div>
      </div>

      <!-- Nav -->
      <nav class="sidebar-nav" aria-label="Portal sections">
        <div class="nav-section-label">Main</div>

        <button class="nav-item active" data-section="dashboard" aria-current="page">
          <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
          Dashboard
        </button>

