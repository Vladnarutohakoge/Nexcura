      <!-- ══════════════════════════════
           SECTION 3: INTAKE FORM
      ══════════════════════════════ -->
      <section class="section" id="sec-intake" aria-labelledby="intake-title">

        <div class="section-header">
          <h1 class="section-title" id="intake-title">Pre-Visit Intake Form</h1>
          <p class="section-subtitle">For your appointment with Dr. Priya Sharma on 28 Sep 2026</p>
        </div>

        <div class="intake-form-wrapper">

          <div class="form-disclaimer" role="note">
            <strong>Important:</strong> This information helps your care team prepare for your visit. It is <strong>not a diagnosis</strong>. All responses are user-reported and will be flagged for clinical review by your care team. Do not use this form for emergencies.
          </div>

          <form id="intakeForm" novalidate aria-label="Pre-visit intake questionnaire">

            <!-- Reason for visit -->
            <div class="form-group">
              <label class="field-label" for="reasonVisit">
                Reason for Visit <span class="required" aria-label="required">*</span>
              </label>
              <input
                type="text"
                class="form-input"
                id="reasonVisit"
                name="reasonVisit"
                placeholder="e.g. Follow-up on blood pressure, persistent fatigue"
                required
                aria-required="true"
                aria-describedby="reasonHint"
              />
              <p class="form-hint" id="reasonHint">Briefly describe the main reason for your visit in your own words.</p>
            </div>

            <!-- Current Symptoms -->
            <div class="form-group">
              <fieldset>
                <legend class="field-label" style="margin-bottom:8px;">
                  Current Symptoms <span class="required" aria-label="required">*</span>
                </legend>
                <div class="checkbox-group" role="group" aria-label="Select all symptoms that apply">
                  <label class="checkbox-label">
                    <input type="checkbox" name="symptoms" value="fatigue" />
                    Fatigue
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="symptoms" value="headache" />
                    Headache
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="symptoms" value="nausea" />
                    Nausea
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="symptoms" value="sob" />
                    Shortness of Breath
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="symptoms" value="dizziness" />
                    Dizziness
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="symptoms" value="chest-pain" />
                    Chest Discomfort
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="symptoms" value="other" id="symptomOther" />
                    Other
                  </label>
                </div>
              </fieldset>
            </div>

            <!-- Other symptoms -->
            <div class="form-group" id="otherSymptomGroup" style="display:none;">
              <label class="field-label" for="otherSymptomText">Please describe other symptoms</label>
              <input type="text" class="form-input" id="otherSymptomText" name="otherSymptomText" placeholder="Describe any other symptoms" />
            </div>

            <!-- Symptom Duration -->
            <div class="form-group">
              <label class="field-label" for="symptomDuration">
                How long have you been experiencing these symptoms? <span class="required" aria-label="required">*</span>
              </label>
              <select class="form-select" id="symptomDuration" name="symptomDuration" required aria-required="true">
                <option value="" disabled selected>Select duration</option>
                <option value="lt1day">Less than 1 day</option>
                <option value="1-3days">1–3 days</option>
                <option value="4-7days">4–7 days</option>
                <option value="1-2weeks">1–2 weeks</option>
                <option value="2-4weeks">2–4 weeks</option>
                <option value="1-3months">1–3 months</option>
                <option value="gt3months">More than 3 months</option>
                <option value="ongoing">Ongoing / Chronic</option>
              </select>
            </div>

            <hr class="form-section-divider" />
            <p class="form-section-title">Current Medications &amp; Allergies</p>

            <!-- Medications -->
            <div class="form-group">
              <label class="field-label" for="currentMeds">Current Medications</label>
              <textarea
                class="form-textarea"
                id="currentMeds"
                name="currentMeds"
                placeholder="List any medications you are currently taking, including over-the-counter drugs and supplements. Include name and dosage if known. (User-reported)"
                aria-describedby="medsHint"
              ></textarea>
              <p class="form-hint" id="medsHint">Example: Metformin 500mg twice daily, Aspirin 75mg once daily, Vitamin D3 supplement.</p>
            </div>

            <!-- Allergies -->
            <div class="form-group">
              <label class="field-label" for="allergies">Known Allergies or Adverse Reactions</label>
              <textarea
                class="form-textarea"
                id="allergies"
                name="allergies"
                placeholder="List any known drug, food, or environmental allergies. Note the type of reaction if known. (User-reported)"
                aria-describedby="allergyHint"
              ></textarea>
              <p class="form-hint" id="allergyHint">Example: Penicillin – rash and hives; Shellfish – anaphylaxis; Pollen – sneezing, watery eyes.</p>
            </div>

            <hr class="form-section-divider" />
            <p class="form-section-title">Additional Information</p>

            <!-- Concerns for doctor -->
            <div class="form-group">
              <label class="field-label" for="concerns">Questions or Concerns for Your Doctor</label>
              <textarea
                class="form-textarea"
                id="concerns"
                name="concerns"
                rows="4"
                placeholder="List any specific questions or concerns you'd like to discuss during your visit. (User-reported)"
              ></textarea>
            </div>

            <!-- Pain scale -->
            <div class="form-group">
              <label class="field-label" for="painScale">Current Discomfort Level (0 = None, 10 = Severe)</label>
              <input type="range" id="painScale" name="painScale" min="0" max="10" value="3" style="width:100%; accent-color:var(--teal);" aria-valuemin="0" aria-valuemax="10" aria-valuenow="3" oninput="document.getElementById('painVal').textContent=this.value; this.setAttribute('aria-valuenow', this.value);" />
              <div style="display:flex; justify-content:space-between; font-size:.75rem; color:var(--muted); margin-top:4px;">
                <span>0 — None</span>
                <span>Current: <strong id="painVal">3</strong></span>
                <span>10 — Severe</span>
              </div>
            </div>

            <!-- Submission disclaimer -->
            <div class="form-disclaimer" style="margin-top:24px;" role="note">
              <strong>Submission note:</strong> By submitting this form, you confirm that all responses are user-reported and self-assessed. This information will be flagged for review by your clinical care team and does not constitute medical advice, a diagnosis, or a prescription.
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">Submit Intake Form</button>
              <button type="button" class="btn btn-secondary" onclick="document.getElementById('intakeForm').reset(); document.getElementById('painVal').textContent='3';">Clear Form</button>
            </div>

            <!-- Success Toast -->
            <div class="toast" id="intakeToast" role="status" aria-live="polite">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="var(--success-green)" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Intake form submitted successfully. Your care team will review before your appointment. <strong>(Illustrative demo — no data transmitted)</strong>
            </div>

          </form>
        </div>

      </section>

